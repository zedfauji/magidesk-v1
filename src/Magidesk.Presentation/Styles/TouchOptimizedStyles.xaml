<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Touch Target Minimum Sizes -->
    <x:Double x:Key="TouchTargetMinWidth">44</x:Double>
    <x:Double x:Key="TouchTargetMinHeight">44</x:Double>
    <x:Double x:Key="TouchTargetMinSpacing">8</x:Double>

    <!-- Large Touch Button Style (120x120 for Switchboard) -->
    <Style x:Key="LargeTouchButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="120"/>
        <Setter Property="Height" Value="120"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Touch-Optimized Button Style (Minimum 44x44) -->
    <Style x:Key="TouchButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="{StaticResource TouchTargetMinWidth}"/>
        <Setter Property="MinHeight" Value="{StaticResource TouchTargetMinHeight}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- Touch-Optimized Primary Button -->
    <Style x:Key="TouchPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource TouchButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Touch-Optimized Icon Button -->
    <Style x:Key="TouchIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource TouchTargetMinWidth}"/>
        <Setter Property="Height" Value="{StaticResource TouchTargetMinHeight}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Touch-Optimized TextBox -->
    <Style x:Key="TouchTextBoxStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="{StaticResource TouchTargetMinHeight}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- Touch-Optimized ComboBox -->
    <Style x:Key="TouchComboBoxStyle" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="{StaticResource TouchTargetMinHeight}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- Touch-Optimized CheckBox -->
    <Style x:Key="TouchCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="MinWidth" Value="{StaticResource TouchTargetMinWidth}"/>
        <Setter Property="MinHeight" Value="{StaticResource TouchTargetMinHeight}"/>
        <Setter Property="Padding" Value="8,0,0,0"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- Touch-Optimized RadioButton -->
    <Style x:Key="TouchRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="MinWidth" Value="{StaticResource TouchTargetMinWidth}"/>
        <Setter Property="MinHeight" Value="{StaticResource TouchTargetMinHeight}"/>
        <Setter Property="Padding" Value="8,0,0,0"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- Large Font Styles for Touch -->
    <Style x:Key="TouchTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="TouchBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style x:Key="TouchCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <!-- Touch Ripple Effect (Visual Feedback) -->
    <Style x:Key="TouchRippleButtonStyle" TargetType="Button" BasedOn="{StaticResource TouchButtonStyle}">
        <Setter Property="Transitions">
            <Setter.Value>
                <TransitionCollection>
                    <RepositionThemeTransition/>
                </TransitionCollection>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
