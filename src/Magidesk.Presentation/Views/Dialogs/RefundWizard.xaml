<ContentDialog
    x:Class="Magidesk.Presentation.Views.Dialogs.RefundWizard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Magidesk.Presentation.ViewModels"
    xmlns:converters="using:Magidesk.Presentation.Converters"
    mc:Ignorable="d"
    Title="{Binding StepTitle}"
    PrimaryButtonText="{Binding PrimaryButtonText}"
    SecondaryButtonText="Back"
    CloseButtonText="Cancel"
    PrimaryButtonCommand="{Binding NextCommand}"
    SecondaryButtonCommand="{Binding BackCommand}"
    IsPrimaryButtonEnabled="{Binding IsNotBusy}"
    IsSecondaryButtonEnabled="{Binding IsNotBusy}"
    x:Name="RefundDialog">

    <ContentDialog.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:StringFormatConverter x:Key="StringFormatConverter"/>
        <x:String x:Key="CurrencyFormat">{0:C}</x:String>
        
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        
        <Style TargetType="TextBlock" x:Key="SectionHeaderStyle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </ContentDialog.Resources>

    <Grid Width="500" MinHeight="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Error Message -->
        <InfoBar Grid.Row="0"
                 Severity="Error"
                 Message="{Binding ErrorMessage}"
                 IsOpen="{Binding HasError}"
                 IsClosable="True"
                 Margin="0,0,0,16"/>

        <!-- Step Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                
                <!-- Step 1: Select Refund Mode -->
                <StackPanel Visibility="{Binding IsStep1Visible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Spacing="12">
                    <TextBlock Text="Select Refund Type" Style="{StaticResource SectionHeaderStyle}"/>
                    
                    <RadioButton Content="Full Refund"
                                 IsChecked="{Binding IsFullMode, Mode=TwoWay}"
                                 GroupName="RefundMode">
                        <RadioButton.ContentTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Full Refund" FontWeight="SemiBold"/>
                                    <TextBlock Text="Refund the entire ticket amount" 
                                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                             FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </RadioButton.ContentTemplate>
                    </RadioButton>
                    
                    <RadioButton Content="Partial Refund"
                                 IsChecked="{Binding IsPartialMode, Mode=TwoWay}"
                                 GroupName="RefundMode">
                        <RadioButton.ContentTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Partial Refund" FontWeight="SemiBold"/>
                                    <TextBlock Text="Refund a specific amount" 
                                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                             FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </RadioButton.ContentTemplate>
                    </RadioButton>
                    
                    <RadioButton Content="Specific Payments"
                                 IsChecked="{Binding IsSpecificMode, Mode=TwoWay}"
                                 GroupName="RefundMode">
                        <RadioButton.ContentTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Specific Payments" FontWeight="SemiBold"/>
                                    <TextBlock Text="Select individual payments to refund" 
                                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                             FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </RadioButton.ContentTemplate>
                    </RadioButton>
                </StackPanel>

                <!-- Step 2: Enter Amount or Select Payments -->
                <StackPanel Visibility="{Binding IsStep2Visible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Spacing="12">
                    
                    <!-- Partial Amount Input -->
                    <StackPanel Visibility="{Binding IsPartialMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Spacing="8">
                        <TextBlock Text="Enter Refund Amount" Style="{StaticResource SectionHeaderStyle}"/>
                        <NumberBox Value="{Binding PartialAmountInput, Mode=TwoWay}"
                                   Header="Amount"
                                   PlaceholderText="0.00"
                                   SpinButtonPlacementMode="Inline"
                                   Minimum="0.01"
                                   SmallChange="1"
                                   LargeChange="10"
                                   HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    
                    <!-- Specific Payments Selection -->
                    <StackPanel Visibility="{Binding IsSpecificMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Spacing="8">
                        <TextBlock Text="Select Payments to Refund" Style="{StaticResource SectionHeaderStyle}"/>
                        <ListView ItemsSource="{Binding SpecificPayments}"
                                  SelectionMode="None"
                                  MaxHeight="300">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Description}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Margin="0,4"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </StackPanel>

                <!-- Step 3: Preview and Reason -->
                <StackPanel Visibility="{Binding IsStep3Visible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Spacing="16">
                    <TextBlock Text="Review Refund" Style="{StaticResource SectionHeaderStyle}"/>
                    
                    <!-- Refund Preview -->
                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Refund Amount:" Grid.Column="0"/>
                                <TextBlock Text="{Binding Preview.RefundAmount, Converter={StaticResource StringFormatConverter}, ConverterParameter={StaticResource CurrencyFormat}}" 
                                           Grid.Column="1"
                                           FontWeight="Bold"/>
                            </Grid>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Original Amount:" Grid.Column="0"/>
                                <TextBlock Text="{Binding Preview.OriginalAmount, Converter={StaticResource StringFormatConverter}, ConverterParameter={StaticResource CurrencyFormat}}" 
                                           Grid.Column="1"/>
                            </Grid>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Remaining Balance:" Grid.Column="0"/>
                                <TextBlock Text="{Binding Preview.RemainingBalance, Converter={StaticResource StringFormatConverter}, ConverterParameter={StaticResource CurrencyFormat}}" 
                                           Grid.Column="1"
                                           FontWeight="SemiBold"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <!-- Refund Reason -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Refund Reason" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding RefundReason, Mode=TwoWay}"
                                 PlaceholderText="Enter reason for refund..."
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="80"
                                 MaxLength="500"/>
                    </StackPanel>
                </StackPanel>

                <!-- Step 4: Authorization -->
                <StackPanel Visibility="{Binding IsStep4Visible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Spacing="16">
                    <TextBlock Text="Manager Authorization Required" Style="{StaticResource SectionHeaderStyle}"/>
                    
                    <InfoBar Severity="Informational"
                             Title="Authorization"
                             Message="A manager PIN is required to authorize this refund."
                             IsOpen="True"
                             IsClosable="False"/>
                    
                    <StackPanel Spacing="8">
                        <TextBlock Text="Manager PIN" Style="{StaticResource LabelStyle}"/>
                        <PasswordBox Password="{Binding ManagerPin, Mode=TwoWay}"
                                     PlaceholderText="Enter manager PIN..."
                                     MaxLength="6"/>
                    </StackPanel>
                    
                    <Button Content="Process Refund"
                            Command="{Binding ConfirmRefundCommand}"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource AccentButtonStyle}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Loading Indicator -->
        <ProgressRing Grid.Row="1"
                      IsActive="{Binding IsBusy}"
                      Width="50"
                      Height="50"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>

    </Grid>
</ContentDialog>
