<ContentDialog
    x:Class="Magidesk.Presentation.Views.Dialogs.CreateInventoryItemDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Magidesk.Presentation.ViewModels.Dialogs"
    xmlns:converters="using:Magidesk.Presentation.Converters"
    mc:Ignorable="d"
    Title="{x:Bind ViewModel.Title, Mode=OneWay}"
    PrimaryButtonText="Create"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonCommand="{x:Bind ViewModel.ConfirmCommand}"
    CloseButtonCommand="{x:Bind ViewModel.CancelCommand}"
    RequestedTheme="Dark">

    <ContentDialog.Resources>
        <converters:DecimalToDoubleConverter x:Key="DecimalToDoubleConverter"/>
    </ContentDialog.Resources>

    <Grid RowSpacing="12" Width="450">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Name TextBox with validation -->
        <TextBox Grid.Row="0"
                 Header="Name *" 
                 Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="Enter item name"
                 MaxLength="200"
                 HorizontalAlignment="Stretch"/>

        <!-- Unit TextBox with validation -->
        <TextBox Grid.Row="1"
                 Header="Unit *" 
                 Text="{x:Bind ViewModel.Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="e.g. kg, lbs, each"
                 MaxLength="50"
                 HorizontalAlignment="Stretch"/>

        <!-- SKU Code TextBox (optional) -->
        <TextBox Grid.Row="2"
                 Header="SKU Code" 
                 Text="{x:Bind ViewModel.SkuCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="Optional SKU code"
                 MaxLength="50"
                 HorizontalAlignment="Stretch"/>

        <!-- Stock Quantity NumberBox -->
        <NumberBox Grid.Row="3"
                   Header="Stock Quantity *"
                   Value="{x:Bind ViewModel.StockQuantity, Mode=TwoWay, Converter={StaticResource DecimalToDoubleConverter}}"
                   PlaceholderText="0.00"
                   SpinButtonPlacementMode="Inline"
                   Minimum="0"
                   LargeChange="10"
                   SmallChange="1"
                   HorizontalAlignment="Stretch"/>

        <!-- Reorder Point NumberBox -->
        <NumberBox Grid.Row="4"
                   Header="Reorder Point *"
                   Value="{x:Bind ViewModel.ReorderPoint, Mode=TwoWay, Converter={StaticResource DecimalToDoubleConverter}}"
                   PlaceholderText="0.00"
                   SpinButtonPlacementMode="Inline"
                   Minimum="0"
                   LargeChange="10"
                   SmallChange="1"
                   HorizontalAlignment="Stretch"/>

        <!-- Category ComboBox -->
        <ComboBox Grid.Row="5"
                  Header="Category"
                  ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                  SelectedValue="{x:Bind ViewModel.SelectedCategoryId, Mode=TwoWay}"
                  SelectedValuePath="Id"
                  DisplayMemberPath="Name"
                  PlaceholderText="Select a category (optional)"
                  HorizontalAlignment="Stretch"/>

        <!-- Error message display area -->
        <InfoBar Grid.Row="6"
                 IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                 Severity="Error"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 IsClosable="False"
                 Margin="0,8,0,0"/>

        <!-- Loading indicator -->
        <ProgressRing Grid.Row="7"
                      IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                      Width="40"
                      Height="40"
                      HorizontalAlignment="Center"
                      Margin="0,8,0,0"/>
    </Grid>
</ContentDialog>
