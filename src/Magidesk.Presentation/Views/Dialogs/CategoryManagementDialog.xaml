<ContentDialog
    x:Class="Magidesk.Presentation.Views.Dialogs.CategoryManagementDialog"
    x:Name="RootDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Magidesk.Presentation.ViewModels.Dialogs"
    xmlns:dto="using:Magidesk.Application.DTOs"
    xmlns:converters="using:Magidesk.Presentation.Converters"
    mc:Ignorable="d"
    Title="{x:Bind ViewModel.Title, Mode=OneWay}"
    CloseButtonText="Close"
    DefaultButton="Close"
    RequestedTheme="Dark"
    MinWidth="700"
    MinHeight="500">

    <ContentDialog.Resources>
        <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </ContentDialog.Resources>

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Status message display area -->
        <InfoBar Grid.Row="0"
                 IsOpen="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                 Severity="Informational"
                 Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                 IsClosable="True"
                 Margin="0,0,0,8"/>

        <!-- Category ListView/DataGrid -->
        <Grid Grid.Row="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Categories"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,0,0,8"/>

            <ListView Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                      SelectionMode="Single"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="0"
                      MinHeight="200">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="dto:InventoryCategoryDto">
                        <Grid Padding="12,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{x:Bind Name}" 
                                           FontWeight="SemiBold"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind SortOrder, Mode=OneWay}" 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}">
                                    <Run Text="Sort Order: "/>
                                    <Run Text="{x:Bind SortOrder, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="Edit"
                                    Command="{Binding ElementName=RootDialog, Path=ViewModel.EnterEditModeCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Padding="12,6"
                                    FontSize="12"/>

                            <Button Grid.Column="2"
                                    Content="Delete"
                                    Command="{Binding ElementName=RootDialog, Path=ViewModel.DeleteCategoryCommand}"
                                    CommandParameter="{x:Bind Id}"
                                    Padding="12,6"
                                    FontSize="12"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Create Category section -->
        <Grid Grid.Row="2" 
              RowSpacing="12" 
              Padding="16"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Visibility="{x:Bind ViewModel.IsEditMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Create New Category"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,0,0,8"/>

            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Header="Name *"
                         Text="{x:Bind ViewModel.NewCategoryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Enter category name"
                         MaxLength="100"
                         HorizontalAlignment="Stretch"/>

                <NumberBox Grid.Column="1"
                           Header="Sort Order *"
                           Value="{x:Bind ViewModel.NewCategorySortOrder, Mode=TwoWay}"
                           PlaceholderText="0"
                           SpinButtonPlacementMode="Inline"
                           Minimum="0"
                           LargeChange="10"
                           SmallChange="1"
                           HorizontalAlignment="Stretch"/>
            </Grid>

            <Button Grid.Row="2"
                    Content="Create Category"
                    Command="{x:Bind ViewModel.CreateCategoryCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Left"
                    Margin="0,4,0,0"/>
        </Grid>

        <!-- Edit Category section (shown when category selected) -->
        <Grid Grid.Row="2" 
              RowSpacing="12" 
              Padding="16"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Visibility="{x:Bind ViewModel.IsEditMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Edit Category"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,0,0,8"/>

            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Header="Name *"
                         Text="{x:Bind ViewModel.EditCategoryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Enter category name"
                         MaxLength="100"
                         HorizontalAlignment="Stretch"/>

                <NumberBox Grid.Column="1"
                           Header="Sort Order *"
                           Value="{x:Bind ViewModel.EditCategorySortOrder, Mode=TwoWay}"
                           PlaceholderText="0"
                           SpinButtonPlacementMode="Inline"
                           Minimum="0"
                           LargeChange="10"
                           SmallChange="1"
                           HorizontalAlignment="Stretch"/>
            </Grid>

            <StackPanel Grid.Row="2" 
                        Orientation="Horizontal" 
                        Spacing="8"
                        Margin="0,4,0,0">
                <Button Content="Save Changes"
                        Command="{x:Bind ViewModel.UpdateCategoryCommand}"
                        Style="{StaticResource AccentButtonStyle}"/>
                <Button Content="Cancel"
                        Command="{x:Bind ViewModel.CancelEditCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Loading indicator -->
        <ProgressRing Grid.Row="3"
                      IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                      Width="40"
                      Height="40"
                      HorizontalAlignment="Center"
                      Margin="0,8,0,0"/>
    </Grid>
</ContentDialog>
