<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Magidesk.Presentation.Views.AuditLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dto="using:Magidesk.Application.DTOs"
    xmlns:enums="using:Magidesk.Domain.Enumerations"
    xmlns:converters="using:Magidesk.Presentation.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:DateTimeToStringConverter x:Key="DateTimeToStringConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:StringVisibilityConverter x:Key="StringVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="24,16,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <TextBlock Text="Audit Log" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="View and export system activity history" 
                           Style="{StaticResource CaptionTextBlockStyle}" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                <Button Command="{x:Bind ViewModel.ExportCommand}"
                        Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="16"/>
                        <TextBlock Text="Export"/>
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.LoadAuditLogsCommand}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5"/>
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="16"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Filter Controls -->
        <Grid Grid.Row="1" Padding="24,8,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" 
                         x:Name="SearchBox"
                         PlaceholderText="Search by description, entity ID, or correlation ID..." 
                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,12,0">
                    <TextBox.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Enter" Invoked="OnSearchKeyboardAccelerator"/>
                    </TextBox.KeyboardAccelerators>
                </TextBox>

                <Button Grid.Column="1" 
                        Content="Search" 
                        Command="{x:Bind ViewModel.SearchCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        Margin="0,0,8,0">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F3"/>
                    </Button.KeyboardAccelerators>
                </Button>

                <Button Grid.Column="2" 
                        Content="Clear Filters" 
                        Command="{x:Bind ViewModel.ClearFiltersCommand}"/>
            </Grid>

            <!-- Filter Dropdowns and Date Range -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- User Filter -->
                <ComboBox Grid.Column="0" 
                          Header="User"
                          ItemsSource="{x:Bind ViewModel.Users, Mode=OneWay}"
                          SelectedValue="{x:Bind ViewModel.SelectedUserId, Mode=TwoWay}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="Username"
                          HorizontalAlignment="Stretch"
                          Margin="0,0,8,0"/>

                <!-- Event Type Filter -->
                <ComboBox Grid.Column="1" 
                          Header="Event Type"
                          ItemsSource="{x:Bind ViewModel.EventTypes, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedEventType, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"
                          Margin="0,0,8,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="enums:AuditEventType">
                            <TextBlock Text="{x:Bind}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Entity Type Filter -->
                <ComboBox Grid.Column="2" 
                          Header="Entity Type"
                          ItemsSource="{x:Bind ViewModel.EntityTypes, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedEntityType, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"
                          Margin="0,0,8,0"/>

                <!-- Start Date -->
                <CalendarDatePicker Grid.Column="3" 
                                    Header="Start Date"
                                    Date="{x:Bind ViewModel.StartDate, Mode=TwoWay}"
                                    Margin="0,0,8,0"
                                    Width="150"/>

                <!-- End Date -->
                <CalendarDatePicker Grid.Column="4" 
                                    Header="End Date"
                                    Date="{x:Bind ViewModel.EndDate, Mode=TwoWay}"
                                    Width="150"/>
            </Grid>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="2" Padding="24,0,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Audit Log DataGrid -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- List Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="0,0,0,12">
                    <TextBlock Text="Audit Entries" 
                               Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center">
                        <Run Text="Total:"/>
                        <Run Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="entries"/>
                    </TextBlock>
                </StackPanel>

                <!-- DataGrid -->
                <Border Grid.Row="1" 
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <ListView x:Name="AuditLogList"
                              ItemsSource="{x:Bind ViewModel.AuditLogs, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedAuditLog, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="dto:AuditLogDto">
                                <Grid Padding="12,8" 
                                      Background="Transparent"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Event Type Icon -->
                                    <Border Grid.Column="0" Grid.RowSpan="2"
                                            Width="40" Height="40"
                                            CornerRadius="20"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE7C3;" 
                                                  FontSize="20" 
                                                  Foreground="White"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Main Info -->
                                    <StackPanel Grid.Column="1" Grid.Row="0" Spacing="4">
                                        <TextBlock Text="{x:Bind Description}" 
                                                   Style="{StaticResource BodyTextBlockStyle}" 
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="User:"/>
                                                <Run Text="{x:Bind UserName}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="Type:"/>
                                                <Run Text="{x:Bind EventType}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="Entity:"/>
                                                <Run Text="{x:Bind EntityType}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Timestamp -->
                                    <TextBlock Grid.Column="2" Grid.Row="0"
                                               Text="{x:Bind Timestamp, Converter={StaticResource DateTimeToStringConverter}}" 
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="12,0"/>

                                    <!-- Chevron -->
                                    <FontIcon Grid.Column="3" Grid.Row="0"
                                              Glyph="&#xE76C;" 
                                              FontSize="12"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <!-- Empty State -->
                <StackPanel Grid.Row="1" 
                            VerticalAlignment="Center" 
                            HorizontalAlignment="Center"
                            Spacing="12"
                            Visibility="{x:Bind ViewModel.TotalCount, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE7C3;" FontSize="64" 
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="No audit entries found" 
                               Style="{StaticResource SubtitleTextBlockStyle}" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="Try adjusting your filters or date range" 
                               Style="{StaticResource CaptionTextBlockStyle}" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Detail Panel -->
            <Grid Grid.Column="1" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Detail Panel Header -->
                <TextBlock Grid.Row="0" 
                           Text="Entry Details" 
                           Style="{StaticResource SubtitleTextBlockStyle}" 
                           Margin="0,0,0,12"/>

                <!-- Detail Panel Content -->
                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16"
                                    Visibility="{x:Bind ViewModel.SelectedAuditLog, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        
                        <!-- Basic Information Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                CornerRadius="8" 
                                Padding="16"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Basic Information" 
                                           Style="{StaticResource BodyTextBlockStyle}" 
                                           FontWeight="SemiBold"/>
                                
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" 
                                                   Text="Event Type:" 
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Column="1" 
                                                   Text="{x:Bind ViewModel.SelectedAuditLog.EventType, Mode=OneWay}" 
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   FontWeight="SemiBold"/>
                                    </Grid>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" 
                                                   Text="User:" 
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Column="1" 
                                                   Text="{x:Bind ViewModel.SelectedAuditLog.UserName, Mode=OneWay}" 
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   FontWeight="SemiBold"/>
                                    </Grid>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" 
                                                   Text="Timestamp:" 
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Column="1" 
                                                   Text="{x:Bind ViewModel.SelectedAuditLog.Timestamp, Mode=OneWay, Converter={StaticResource DateTimeToStringConverter}}" 
                                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                                    </Grid>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" 
                                                   Text="Entity Type:" 
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Column="1" 
                                                   Text="{x:Bind ViewModel.SelectedAuditLog.EntityType, Mode=OneWay}" 
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   FontWeight="SemiBold"/>
                                    </Grid>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" 
                                                   Text="Entity ID:" 
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Column="1" 
                                                   Text="{x:Bind ViewModel.SelectedAuditLog.EntityId, Mode=OneWay}" 
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   FontFamily="Consolas"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Description Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                CornerRadius="8" 
                                Padding="16"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Description" 
                                           Style="{StaticResource BodyTextBlockStyle}" 
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind ViewModel.SelectedAuditLog.Description, Mode=OneWay}" 
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Before State Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                CornerRadius="8" 
                                Padding="16"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Visibility="{x:Bind ViewModel.SelectedAuditLog.BeforeState, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Before State" 
                                           Style="{StaticResource BodyTextBlockStyle}" 
                                           FontWeight="SemiBold"/>
                                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedAuditLog.BeforeState, Mode=OneWay}" 
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               FontFamily="Consolas"
                                               TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- After State Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                CornerRadius="8" 
                                Padding="16"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Visibility="{x:Bind ViewModel.SelectedAuditLog.AfterState, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="After State" 
                                           Style="{StaticResource BodyTextBlockStyle}" 
                                           FontWeight="SemiBold"/>
                                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedAuditLog.AfterState, Mode=OneWay}" 
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               FontFamily="Consolas"
                                               TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Correlation ID Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                CornerRadius="8" 
                                Padding="16"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Visibility="{x:Bind ViewModel.SelectedAuditLog.CorrelationId, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Correlation ID" 
                                           Style="{StaticResource BodyTextBlockStyle}" 
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind ViewModel.SelectedAuditLog.CorrelationId, Mode=OneWay}" 
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           FontFamily="Consolas"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- No Selection State -->
                    <StackPanel VerticalAlignment="Center" 
                                HorizontalAlignment="Center"
                                Spacing="12"
                                Visibility="{x:Bind ViewModel.SelectedAuditLog, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE7C3;" FontSize="48" 
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="No entry selected" 
                                   Style="{StaticResource BodyTextBlockStyle}" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Select an entry from the list to view details" 
                                   Style="{StaticResource CaptionTextBlockStyle}" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="200"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Pagination Controls -->
        <Grid Grid.Row="3" Padding="24,8,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Page Info -->
            <TextBlock Grid.Column="0" 
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center">
                <Run Text="Page"/>
                <Run Text="{x:Bind ViewModel.CurrentPage, Mode=OneWay}" FontWeight="SemiBold"/>
                <Run Text="of"/>
                <Run Text="{x:Bind ViewModel.TotalPages, Mode=OneWay}" FontWeight="SemiBold"/>
                <Run Text="•"/>
                <Run Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}" FontWeight="SemiBold"/>
                <Run Text="total entries"/>
            </TextBlock>

            <!-- Pagination Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="First" 
                        Command="{x:Bind ViewModel.FirstPageCommand}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Home" Modifiers="Control"/>
                    </Button.KeyboardAccelerators>
                </Button>
                <Button Command="{x:Bind ViewModel.PreviousPageCommand}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Left" Modifiers="Control"/>
                    </Button.KeyboardAccelerators>
                    <FontIcon Glyph="&#xE76B;" FontSize="16"/>
                </Button>
                <Button Command="{x:Bind ViewModel.NextPageCommand}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Right" Modifiers="Control"/>
                    </Button.KeyboardAccelerators>
                    <FontIcon Glyph="&#xE76C;" FontSize="16"/>
                </Button>
                <Button Content="Last" 
                        Command="{x:Bind ViewModel.LastPageCommand}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="End" Modifiers="Control"/>
                    </Button.KeyboardAccelerators>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="4" 
              Background="{ThemeResource SystemControlAcrylicWindowBrush}" 
              Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="48" Height="48"/>
                <TextBlock Text="Loading audit logs..." 
                           Style="{StaticResource SubtitleTextBlockStyle}" 
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Error Display -->
        <InfoBar Grid.RowSpan="4"
                 IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Severity="Error"
                 Title="Error"
                 Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                 VerticalAlignment="Top"
                 Margin="24,80,24,0"/>

        <!-- Status Message Display -->
        <InfoBar Grid.RowSpan="4"
                 IsOpen="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}"
                 Severity="Success"
                 Title="Success"
                 Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                 VerticalAlignment="Top"
                 Margin="24,80,24,0"/>
    </Grid>
</Page>
