<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Magidesk.Presentation.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Magidesk.Presentation.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    IsTabStop="True"
    KeyDown="Page_KeyDown"
    Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Branding -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,40,0,20" Spacing="8">
            <TextBlock Text="🏪 MAGIDESK POS" 
                       Style="{StaticResource DisplayTextBlockStyle}" 
                       FontWeight="Bold" 
                       Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{x:Bind ViewModel.TerminalId, Mode=OneWay, FallbackValue='Terminal: POS-01'}" 
                       Style="{StaticResource SubtitleTextBlockStyle}" 
                       Opacity="0.6" 
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Main Content Area - Side by Side Layout -->
        <Grid Grid.Row="1" 
              HorizontalAlignment="Center" 
              VerticalAlignment="Center"
              MaxWidth="1200">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left Side: User Selection Grid -->
            <StackPanel Grid.Column="0" 
                        Spacing="16" 
                        VerticalAlignment="Center"
                        MaxWidth="700">
                <TextBlock Text="Select User:" 
                           Style="{StaticResource SubtitleTextBlockStyle}" 
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>

                <GridView ItemsSource="{x:Bind ViewModel.Users, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedUser, Mode=TwoWay}"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          HorizontalAlignment="Center"
                          MaxWidth="700"
                          AutomationProperties.AutomationId="UserSelectionGridView">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" 
                                           MaximumRowsOrColumns="3"/>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border Width="200" 
                                    Height="180" 
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="8">
                                <StackPanel HorizontalAlignment="Center" 
                                            VerticalAlignment="Center" 
                                            Spacing="12">
                                    <!-- User Avatar/Photo Placeholder -->
                                    <Viewbox Width="80" Height="80">
                                        <FontIcon Glyph="&#xE77B;" 
                                                  FontFamily="Segoe Fluent Icons"
                                                  Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                                    </Viewbox>

                                    <!-- User Name -->
                                    <TextBlock Text="{Binding FirstName}" 
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               HorizontalAlignment="Center"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding LastName}" 
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               HorizontalAlignment="Center"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- User Role -->
                                    <TextBlock Text="{Binding RoleName}" 
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>
            </StackPanel>

            <!-- Right Side: PIN Entry Section -->
            <StackPanel Grid.Column="2" 
                        Spacing="16" 
                        MaxWidth="400"
                        VerticalAlignment="Center">
                <TextBlock Text="Enter PIN:" 
                           Style="{StaticResource SubtitleTextBlockStyle}" 
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>

                <!-- PIN Display -->
                <Border Background="{ThemeResource SystemControlBackgroundAltHighBrush}" 
                        Padding="16" 
                        CornerRadius="8"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <TextBlock Text="{x:Bind ViewModel.MaskedPin, Mode=OneWay, FallbackValue='●●●●●●'}" 
                               Style="{StaticResource TitleTextBlockStyle}" 
                               HorizontalAlignment="Center" 
                               MinHeight="40"
                               VerticalAlignment="Center"
                               FontFamily="Consolas"
                               AutomationProperties.AutomationId="PinDisplayTextBlock"/>
                </Border>

                <!-- Error Message -->
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" 
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" 
                           HorizontalAlignment="Center" 
                           TextWrapping="Wrap" 
                           MinHeight="20"
                           AutomationProperties.AutomationId="ErrorMessageTextBlock"/>

                <!-- Numeric Keypad -->
                <Grid RowSpacing="8" ColumnSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="60"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 1: 1, 2, 3 -->
                    <Button Grid.Row="0" Grid.Column="0" 
                            Content="1" 
                            Command="{x:Bind ViewModel.AppendDigitCommand}" 
                            CommandParameter="1" 
                            HorizontalAlignment="Stretch" 
                            VerticalAlignment="Stretch" 
                            FontSize="24"
                            FontWeight="SemiBold"
                            AutomationProperties.Name="Digit 1"
                            AutomationProperties.AutomationId="Digit1Button"/>
                    <Button Grid.Row="0" Grid.Column="1" 
                            Content="2" 
                            Command="{x:Bind ViewModel.AppendDigitCommand}" 
                            CommandParameter="2" 
                            HorizontalAlignment="Stretch" 
                            VerticalAlignment="Stretch" 
                            FontSize="24"
                            FontWeight="SemiBold"
                            AutomationProperties.Name="Digit 2"
                            AutomationProperties.AutomationId="Digit2Button"/>
                    <Button Grid.Row="0" Grid.Column="2" 
                            Content="3" 
                            Command="{x:Bind ViewModel.AppendDigitCommand}" 
                            CommandParameter="3" 
                            HorizontalAlignment="Stretch" 
                            VerticalAlignment="Stretch" 
                            FontSize="24"
                            FontWeight="SemiBold"
                            AutomationProperties.Name="Digit 3"
                            AutomationProperties.AutomationId="Digit3Button"/>

                    <!-- Row 2: 4, 5, 6 -->
                    <Button Grid.Row="1" Grid.Column="0" 
                            Content="4" 
                            Command="{x:Bind ViewModel.AppendDigitCommand}" 
                            CommandParameter="4" 
                            HorizontalAlignment="Stretch" 
                            VerticalAlignment="Stretch" 
                            FontSize="24"
                            FontWeight="SemiBold"
                            AutomationProperties.Name="Digit 4"
                            AutomationProperties.AutomationId="Digit4Button"/>
                    <Button Grid.Row="1" Grid.Column="1" 
                            Content="5" 
                            Command="{x:Bind ViewModel.AppendDigitCommand}" 
                            CommandParameter="5" 
                            HorizontalAlignment="Stretch" 
                            VerticalAlignment="Stretch" 
                            FontSize="24"
                            FontWeight="SemiBold"
                            AutomationProperties.Name="Digit 5"
                            AutomationProperties.AutomationId="Digit5Button"/>
                    <Button Grid.Row="1" Grid.Column="2" 
                            Content="6" 
                            Command="{x:Bind ViewModel.AppendDigitCommand}" 
                            CommandParameter="6" 
                            HorizontalAlignment="Stretch" 
                            VerticalAlignment="Stretch" 
                            FontSize="24"
                            FontWeight="SemiBold"
                            AutomationProperties.Name="Digit 6"
                            AutomationProperties.AutomationId="Digit6Button"/>

                    <!-- Row 3: 7, 8, 9 -->
                    <Button Grid.Row="2" Grid.Column="0" 
                            Content="7" 
                            Command="{x:Bind ViewModel.AppendDigitCommand}" 
                            CommandParameter="7" 
                            HorizontalAlignment="Stretch" 
                            VerticalAlignment="Stretch" 
                            FontSize="24"
                            FontWeight="SemiBold"
                            AutomationProperties.Name="Digit 7"
                            AutomationProperties.AutomationId="Digit7Button"/>
                    <Button Grid.Row="2" Grid.Column="1" 
                            Content="8" 
                            Command="{x:Bind ViewModel.AppendDigitCommand}" 
                            CommandParameter="8" 
                            HorizontalAlignment="Stretch" 
                            VerticalAlignment="Stretch" 
                            FontSize="24"
                            FontWeight="SemiBold"
                            AutomationProperties.Name="Digit 8"
                            AutomationProperties.AutomationId="Digit8Button"/>
                    <Button Grid.Row="2" Grid.Column="2" 
                            Content="9" 
                            Command="{x:Bind ViewModel.AppendDigitCommand}" 
                            CommandParameter="9" 
                            HorizontalAlignment="Stretch" 
                            VerticalAlignment="Stretch" 
                            FontSize="24"
                            FontWeight="SemiBold"
                            AutomationProperties.Name="Digit 9"
                            AutomationProperties.AutomationId="Digit9Button"/>

                    <!-- Row 4: Backspace, 0, Enter -->
                    <Button Grid.Row="3" Grid.Column="0" 
                            Command="{x:Bind ViewModel.RemoveLastDigitCommand}" 
                            HorizontalAlignment="Stretch" 
                            VerticalAlignment="Stretch"
                            AutomationProperties.Name="Backspace"
                            AutomationProperties.AutomationId="BackspaceButton">
                        <FontIcon Glyph="&#xE750;" 
                                  FontFamily="Segoe Fluent Icons"
                                  FontSize="20"/>
                    </Button>
                    <Button Grid.Row="3" Grid.Column="1" 
                            Content="0" 
                            Command="{x:Bind ViewModel.AppendDigitCommand}" 
                            CommandParameter="0" 
                            HorizontalAlignment="Stretch" 
                            VerticalAlignment="Stretch" 
                            FontSize="24"
                            FontWeight="SemiBold"
                            AutomationProperties.Name="Digit 0"
                            AutomationProperties.AutomationId="Digit0Button"/>
                    <Button Grid.Row="3" Grid.Column="2" 
                            Command="{x:Bind ViewModel.LoginCommand}" 
                            Background="{ThemeResource SystemControlBackgroundAccentBrush}" 
                            Foreground="White" 
                            HorizontalAlignment="Stretch" 
                            VerticalAlignment="Stretch"
                            AutomationProperties.Name="Login"
                            AutomationProperties.AutomationId="LoginButton">
                        <FontIcon Glyph="&#xE73E;" 
                                  FontFamily="Segoe Fluent Icons"
                                  FontSize="20"/>
                    </Button>
                </Grid>

                <!-- Loading Indicator -->
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" 
                              HorizontalAlignment="Center"
                              Width="40"
                              Height="40"/>

                <!-- Quick Actions -->
                <StackPanel Orientation="Horizontal" 
                            Spacing="8" 
                            HorizontalAlignment="Center" 
                            Margin="0,16,0,0">
                    <Button Content="{Binding Localization[Button_ClockIn], Mode=OneWay, FallbackValue='Clock In/Out'}" 
                            Command="{x:Bind ViewModel.ClockInOutCommand}" 
                            Background="#00695C" 
                            Foreground="White" 
                            MinWidth="120" 
                            Height="44" 
                            FontSize="13"
                            AutomationProperties.Name="Clock In Out"
                            AutomationProperties.AutomationId="ClockInOutButton"/>
                    <Button Content="{Binding Localization[Button_Language], Mode=OneWay, FallbackValue='Language'}" 
                            Command="{x:Bind ViewModel.ChangeLanguageCommand}" 
                            Background="#1565C0" 
                            Foreground="White" 
                            MinWidth="120" 
                            Height="44" 
                            FontSize="13"
                            AutomationProperties.Name="Change Language"
                            AutomationProperties.AutomationId="ChangeLanguageButton"/>
                    <Button Content="{Binding Localization[Button_Shutdown], Mode=OneWay, FallbackValue='Shutdown'}" 
                            Command="{x:Bind ViewModel.ShutdownCommand}" 
                            Background="DarkRed" 
                            Foreground="White" 
                            MinWidth="120" 
                            Height="44" 
                            FontSize="13"
                            AutomationProperties.Name="Shutdown"
                            AutomationProperties.AutomationId="ShutdownButton"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Footer with Version and Settings -->
        <Grid Grid.Row="2" 
              Padding="24,16"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Version Number -->
            <TextBlock Grid.Column="0" 
                       Text="v2.1.0" 
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                       VerticalAlignment="Center"/>

            <!-- Settings Button -->
            <Button Grid.Column="1" 
                    Command="{x:Bind ViewModel.ChangeLanguageCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="12"
                    AutomationProperties.Name="Settings"
                    AutomationProperties.AutomationId="SettingsButton">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE713;" 
                              FontFamily="Segoe Fluent Icons"
                              FontSize="16"/>
                    <TextBlock Text="Settings" 
                               Style="{StaticResource CaptionTextBlockStyle}"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
