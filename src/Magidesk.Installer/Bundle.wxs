<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  
  <!-- 
    Magidesk POS Installer Bundle (Burn Bootstrapper)
    
    This bundle chains all prerequisites and the main application MSI in dependency order:
    1. .NET 8 Desktop Runtime x64 (required for WinUI 3 application)
    2. Windows App SDK 1.6 (required for WinUI 3 runtime components)
    3. Visual C++ Redistributable x64 (required for PostgreSQL and native dependencies)
    4. Magidesk.msi (main application installer with PostgreSQL, database setup, and migrations)
    
    Each prerequisite includes detection logic to skip installation if already present.
    All prerequisites are marked as Permanent to prevent uninstallation when removing Magidesk.
    
    Requirements: 1.1, 3.1, 4.1, 5.1
  -->
  
  <Bundle Name="Magidesk POS"
          Version="0.1.0.0"
          Manufacturer="Magidesk"
          UpgradeCode="A1B2C3D4-E5F6-4A5B-8C9D-0E1F2A3B4C5D">
    
    <!-- Use standard bootstrapper without custom UI for now -->
    <BootstrapperApplicationRef Id="WixStandardBootstrapperApplication.Foundation" />

    <!-- 
      Prerequisite Detection Registry Searches
      
      These searches detect installed prerequisites by checking registry keys.
      Properties are set if the prerequisite is found, allowing the installer
      to skip installation if already present.
      
      Validates: Requirements 3.4, 4.4, 5.4
    -->
    
    <!-- 
      .NET 8 Desktop Runtime Detection
      
      Checks: HKLM\SOFTWARE\dotnet\Setup\InstalledVersions\x64\sharedhost\Version
      Property: DOTNET8_INSTALLED is set if version >= 8.0.0
      
      The .NET installer writes version information to this registry key.
      We check for the presence of the sharedhost key which indicates the
      Desktop Runtime is installed (not just the SDK).
    -->
    <util:RegistrySearch
      Id="SearchDotNet8Runtime"
      Root="HKLM"
      Key="SOFTWARE\dotnet\Setup\InstalledVersions\x64\sharedhost"
      Value="Version"
      Variable="DOTNET8_VERSION"
      Result="exists" />
    
    <!-- 
      Windows App SDK 1.6+ Detection
      
      Checks: HKLM\SOFTWARE\Microsoft\WindowsAppRuntime\1.6
      Property: WINAPPSDK_INSTALLED is set if registry key exists
      
      Windows App SDK registers its installation in this location.
      We check for version 1.6 or later by looking for the 1.6 key.
    -->
    <util:RegistrySearch
      Id="SearchWinAppSDK"
      Root="HKLM"
      Key="SOFTWARE\Microsoft\WindowsAppRuntime\1.6"
      Variable="WINAPPSDK_INSTALLED"
      Result="exists" />
    
    <!-- 
      Visual C++ Redistributable x64 Detection
      
      Checks: HKLM\SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64\Installed
      Property: VCREDIST_INSTALLED is set if value = 1
      
      The VC++ Redistributable (2015-2022) uses version 14.0 registry key.
      The "Installed" value is set to 1 when the redistributable is present.
    -->
    <util:RegistrySearch
      Id="SearchVCRedist"
      Root="HKLM"
      Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64"
      Value="Installed"
      Variable="VCREDIST_INSTALLED"
      Result="exists" />

    <Chain>
      <!-- 
        .NET 8 Desktop Runtime x64
        
        Detection: Checks HKLM\SOFTWARE\dotnet\Setup\InstalledVersions\x64\sharedhost\Version
        DetectCondition: DOTNET8_VERSION (set by util:RegistrySearch above)
        Requirement: Version >= 8.0
        Exit Codes: 0 = success, 3010 = success with reboot required
        
        If DOTNET8_VERSION is set, the runtime is already installed and this
        package will be skipped. Otherwise, it will be installed silently.
        
        Validates: Requirements 3.1, 3.4
      -->
      <ExePackage Id="NetRuntime"
                  SourceFile="..\..\build\installer\staging\prerequisites\windowsdesktop-runtime-8.0-win-x64.exe"
                  InstallCommand="/install /quiet /norestart"
                  RepairCommand="/repair /quiet /norestart"
                  UninstallCommand="/uninstall /quiet /norestart"
                  PerMachine="yes"
                  Permanent="yes"
                  Vital="yes"
                  DetectCondition="DOTNET8_VERSION">
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Value="3010" Behavior="scheduleReboot" />
      </ExePackage>

      <!-- 
        Windows App SDK 1.6 Runtime
        
        Detection: Checks HKLM\SOFTWARE\Microsoft\WindowsAppRuntime\1.6
        DetectCondition: WINAPPSDK_INSTALLED (set by util:RegistrySearch above)
        
        If WINAPPSDK_INSTALLED is set, the SDK is already present and this
        package will be skipped. Otherwise, it will be installed silently.
        
        Validates: Requirements 4.1, 4.4
      -->
      <MsiPackage Id="WinAppSDK"
                  SourceFile="..\..\build\installer\staging\prerequisites\Microsoft.WindowsAppRuntime.1.6.msix"
                  PerMachine="yes"
                  Permanent="yes"
                  Vital="yes"
                  DetectCondition="WINAPPSDK_INSTALLED">
        <!-- MSIX packages handle their own detection via package identity -->
      </MsiPackage>

      <!-- 
        Visual C++ Redistributable x64 (2015-2022)
        
        Detection: Checks HKLM\SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64\Installed = 1
        DetectCondition: VCREDIST_INSTALLED (set by util:RegistrySearch above)
        Requirement: Version >= 14.0 (covers VS 2015, 2017, 2019, 2022)
        Exit Codes: 0 = success, 3010 = success with reboot, 1638 = already installed
        
        If VCREDIST_INSTALLED is set, the redistributable is already present and
        this package will be skipped. Otherwise, it will be installed silently.
        
        Validates: Requirements 5.1, 5.4
      -->
      <ExePackage Id="VCRedist"
                  SourceFile="..\..\build\installer\staging\prerequisites\VC_redist.x64.exe"
                  InstallCommand="/install /quiet /norestart"
                  RepairCommand="/repair /quiet /norestart"
                  UninstallCommand="/uninstall /quiet /norestart"
                  PerMachine="yes"
                  Permanent="yes"
                  Vital="yes"
                  DetectCondition="VCREDIST_INSTALLED">
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Value="3010" Behavior="scheduleReboot" />
        <ExitCode Value="1638" Behavior="success" />
      </ExePackage>

      <!-- 
        Main Magidesk Application MSI
        
        Contains:
        - Application files (Magidesk.exe, DLLs, resources)
        - PostgreSQL 16 binaries and installation custom actions
        - Database creation and EF Core migration custom actions
        - Shortcuts, registry entries, and uninstaller
        
        This package is always installed (no detection condition).
        
        Validates: Requirements 1.1
      -->
      <MsiPackage Id="MagideskMsi"
                  SourceFile="$(var.Magidesk.Installer.TargetPath)"
                  Vital="yes"
                  PerMachine="yes" />
    </Chain>
  </Bundle>
</Wix>
