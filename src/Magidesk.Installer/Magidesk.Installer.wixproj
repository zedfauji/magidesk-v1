<Project Sdk="WixToolset.Sdk/5.0.0">
  <PropertyGroup>
    <OutputName>Magidesk</OutputName>
    <OutputType>Package</OutputType>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <LangVersion>latest</LangVersion>
    
    <!-- Disable auto-inclusion of .wxs files so we can control exactly what gets compiled -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    
    <!-- Define source directory for Heat.exe harvesting -->
    <AppSourceDir>$(SolutionDir)build\installer\staging\app</AppSourceDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Heat" Version="5.0.0" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Explicitly list all .wxs files to compile -->
    <Compile Include="Product.wxs" />
    <Compile Include="Components\ApplicationFiles.wxs" />
    <Compile Include="Components\DirectoryPermissions.wxs" />
    <Compile Include="Components\PostgreSQL.wxs" />
    <Compile Include="Components\Registry.wxs" />
    <Compile Include="Components\Shortcuts.wxs" />
    <Compile Include="UI\InstallDialog.wxs" />
    <Compile Include="UI\ProgressDialog.wxs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Magidesk.Installer.CustomActions\Magidesk.Installer.CustomActions.csproj" />
  </ItemGroup>

  <!-- 
    Heat.exe Integration Target
    
    This target runs Heat.exe before the WiX compilation to harvest application files
    from the staging/app directory and generate the ApplicationFiles.wxs component.
    
    Heat.exe parameters:
    - dir: Source directory to harvest (staging/app)
    - -cg: ComponentGroup ID (ApplicationFiles)
    - -dr: Directory reference (INSTALLFOLDER = C:\Program Files\Magidesk)
    - -gg: Generate GUIDs now (stable GUIDs for components)
    - -sfrag: Suppress Fragment element generation (we provide it in the template)
    - -srd: Suppress root directory element (we use INSTALLFOLDER)
    - -scom: Suppress COM registration
    - -sreg: Suppress registry harvesting
    - -out: Output file path
    
    This target runs before the Compile target to ensure the harvested components
    are available during WiX compilation.
  -->
  <Target Name="HarvestApplicationFiles" BeforeTargets="Compile">
    <Message Text="Harvesting application files from $(AppSourceDir)..." Importance="high" />
    
    <!-- Check if staging directory exists -->
    <Error Condition="!Exists('$(AppSourceDir)')" 
           Text="Application staging directory not found: $(AppSourceDir). Please run the build script to publish the application first." />
    
    <!-- Run Heat.exe to harvest application files -->
    <Exec Command="heat dir &quot;$(AppSourceDir)&quot; -cg ApplicationFiles -dr INSTALLFOLDER -gg -sfrag -srd -scom -sreg -out &quot;$(MSBuildProjectDirectory)\Components\ApplicationFiles.wxs&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
    
    <Message Text="Application files harvested successfully." Importance="high" />
  </Target>
</Project>
