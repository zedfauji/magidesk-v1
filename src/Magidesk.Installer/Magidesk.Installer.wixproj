<Project Sdk="WixToolset.Sdk/5.0.0">
  <PropertyGroup>
    <OutputName>MagideskSetup</OutputName>
    <OutputType>Bundle</OutputType>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Heat" Version="5.0.0" />
    <PackageReference Include="WixToolset.UI" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Bundle.wxs" />
    <Compile Include="Product.wxs" />
    <Compile Include="Components\**\*.wxs" />
    <Compile Include="UI\**\*.wxs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Magidesk.Installer.CustomActions\Magidesk.Installer.CustomActions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\build\installer\staging\**\*" />
  </ItemGroup>
</Project>
