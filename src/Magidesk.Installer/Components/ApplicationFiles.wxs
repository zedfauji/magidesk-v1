<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <!-- 
      Application Files Component
      
      This component group contains all application files harvested from the 
      publish output directory using Heat.exe during the build process.
      
      Target Directory: C:\Program Files\Magidesk (INSTALLFOLDER)
      Source Directory: build/installer/staging/app
      
      The Heat.exe tool automatically generates component definitions for all
      files in the source directory, preserving the directory structure.
      
      Heat.exe command (executed during build):
      heat dir "$(SolutionDir)build\installer\staging\app" 
           -cg ApplicationFiles 
           -dr INSTALLFOLDER 
           -gg 
           -sfrag 
           -srd 
           -var var.AppSourceDir 
           -out "$(ProjectDir)Components\ApplicationFiles.wxs"
      
      Parameters:
      -cg ApplicationFiles    : ComponentGroup ID
      -dr INSTALLFOLDER       : Directory reference (C:\Program Files\Magidesk)
      -gg                     : Generate GUIDs now
      -sfrag                  : Suppress generation of Fragment element
      -srd                    : Suppress root directory element
      -var var.AppSourceDir   : Use preprocessor variable for source path
    -->
    
    <!-- 
      NOTE: This file will be auto-generated by Heat.exe during the build process.
      The ComponentGroup below is a placeholder that will be replaced with the
      actual harvested components.
      
      To manually regenerate this file, run:
      dotnet tool run heat dir "build\installer\staging\app" -cg ApplicationFiles -dr INSTALLFOLDER -gg -sfrag -srd -var var.AppSourceDir -out "src\Magidesk.Installer\Components\ApplicationFiles.wxs"
    -->
    
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <!-- 
        Components will be auto-generated here by Heat.exe
        
        Expected structure after Heat.exe runs:
        - Magidesk.exe
        - Magidesk.dll
        - All application DLLs
        - appsettings.json
        - All WinUI 3 assets and resources
        - Subdirectories with preserved structure
      -->
    </ComponentGroup>
  </Fragment>
</Wix>
