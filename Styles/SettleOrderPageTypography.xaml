<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Typography Styles for Settle and Order Page Redesign -->
    <!-- Using Inter font family with fallback to Segoe UI -->
    
    <!-- Font Family -->
    <FontFamily x:Key="InterFontFamily">Inter, Segoe UI, sans-serif</FontFamily>
    
    <!-- Font Sizes (Based on Tailwind-like scale) -->
    <x:Double x:Key="FontSizeXS">10</x:Double>
    <x:Double x:Key="FontSizeSM">12</x:Double>
    <x:Double x:Key="FontSizeBase">14</x:Double>
    <x:Double x:Key="FontSizeLG">16</x:Double>
    <x:Double x:Key="FontSizeXL">18</x:Double>
    <x:Double x:Key="FontSize2XL">24</x:Double>
    <x:Double x:Key="FontSize3XL">30</x:Double>
    <x:Double x:Key="FontSize4XL">36</x:Double>
    <x:Double x:Key="FontSize5XL">48</x:Double>
    <x:Double x:Key="FontSize6XL">60</x:Double>
    
    <!-- Font Weights -->
    <FontWeight x:Key="FontWeightLight">Light</FontWeight>
    <FontWeight x:Key="FontWeightNormal">Normal</FontWeight>
    <FontWeight x:Key="FontWeightMedium">Medium</FontWeight>
    <FontWeight x:Key="FontWeightSemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="FontWeightBold">Bold</FontWeight>
    <FontWeight x:Key="FontWeightBlack">Black</FontWeight>
    
    <!-- Text Styles -->
    
    <!-- Display Styles (Large headings) -->
    <Style x:Key="Display6XLTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize6XL}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightLight}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    
    <Style x:Key="Display4XLTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize4XL}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    
    <Style x:Key="Display2XLTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize2XL}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBlack}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    
    <!-- Heading Styles -->
    <Style x:Key="HeadingXLTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeXL}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    
    <Style x:Key="HeadingLGTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeLG}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    
    <!-- Body Styles -->
    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBase}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightNormal}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    
    <Style x:Key="BodyBoldTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBase}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    
    <Style x:Key="BodySemiBoldTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBase}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    
    <!-- Small Text Styles -->
    <Style x:Key="SmallTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSM}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightNormal}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>
    
    <Style x:Key="SmallBoldTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSM}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    
    <Style x:Key="SmallUppercaseTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSM}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="CharacterSpacing" Value="50"/>
    </Style>
    
    <!-- Extra Small Text Styles -->
    <Style x:Key="XSmallTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeXS}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightNormal}"/>
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
    </Style>
    
    <Style x:Key="XSmallUppercaseTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeXS}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}"/>
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
        <Setter Property="CharacterSpacing" Value="50"/>
    </Style>
    
    <!-- Label Styles -->
    <Style x:Key="LabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSM}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>
    
    <Style x:Key="LabelUppercaseTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeXS}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="CharacterSpacing" Value="50"/>
    </Style>
    
    <!-- Modifier Text Style (Italic) -->
    <Style x:Key="ModifierTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSM}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightNormal}"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Opacity" Value="0.7"/>
    </Style>
    
</ResourceDictionary>
