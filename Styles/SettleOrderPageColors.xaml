<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- WinUI-Inspired Color Palette for Settle and Order Page Redesign -->
    
    <!-- Primary Colors -->
    <Color x:Key="PrimaryBlueColor">#0078D4</Color>
    <Color x:Key="AccentGreenColor">#107C10</Color>
    <Color x:Key="AccentRedColor">#C42B1C</Color>
    <Color x:Key="AccentPurpleColor">#8E44AD</Color>
    <Color x:Key="AccentGoldColor">#FFB900</Color>
    <Color x:Key="AccentOrangeColor">#F7630C</Color>
    <Color x:Key="AccentIndigoColor">#5B16D0</Color>
    
    <!-- Dark Theme Background Colors -->
    <Color x:Key="BackgroundDarkColor">#1C1C1C</Color>
    <Color x:Key="SurfaceDarkColor">#2B2B2B</Color>
    <Color x:Key="SidebarDarkColor">#202020</Color>
    <Color x:Key="CardDarkColor">#2C2C2C</Color>
    
    <!-- Text Colors -->
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#B3B3B3</Color>
    <Color x:Key="TextTertiaryColor">#808080</Color>
    
    <!-- Border Colors -->
    <Color x:Key="BorderDefaultColor">#3F3F3F</Color>
    <Color x:Key="BorderHoverColor">#0078D4</Color>
    <Color x:Key="BorderFocusColor">#0078D4</Color>
    
    <!-- Status Colors -->
    <Color x:Key="SuccessColor">#107C10</Color>
    <Color x:Key="ErrorColor">#C42B1C</Color>
    <Color x:Key="WarningColor">#FFB900</Color>
    <Color x:Key="InfoColor">#0078D4</Color>
    
    <!-- Solid Color Brushes -->
    <SolidColorBrush x:Key="PrimaryBlueBrush" Color="{StaticResource PrimaryBlueColor}"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreenColor}"/>
    <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRedColor}"/>
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurpleColor}"/>
    <SolidColorBrush x:Key="AccentGoldBrush" Color="{StaticResource AccentGoldColor}"/>
    <SolidColorBrush x:Key="AccentOrangeBrush" Color="{StaticResource AccentOrangeColor}"/>
    <SolidColorBrush x:Key="AccentIndigoBrush" Color="{StaticResource AccentIndigoColor}"/>
    
    <SolidColorBrush x:Key="BackgroundDarkBrush" Color="{StaticResource BackgroundDarkColor}"/>
    <SolidColorBrush x:Key="SurfaceDarkBrush" Color="{StaticResource SurfaceDarkColor}"/>
    <SolidColorBrush x:Key="SidebarDarkBrush" Color="{StaticResource SidebarDarkColor}"/>
    <SolidColorBrush x:Key="CardDarkBrush" Color="{StaticResource CardDarkColor}"/>
    
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>
    
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="{StaticResource BorderDefaultColor}"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHoverColor}"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocusColor}"/>
    
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    
    <!-- Opacity Variations -->
    <SolidColorBrush x:Key="SurfaceDarkBrush80" Color="{StaticResource SurfaceDarkColor}" Opacity="0.8"/>
    <SolidColorBrush x:Key="SurfaceDarkBrush60" Color="{StaticResource SurfaceDarkColor}" Opacity="0.6"/>
    <SolidColorBrush x:Key="TextSecondaryBrush70" Color="{StaticResource TextSecondaryColor}" Opacity="0.7"/>
    
</ResourceDictionary>
