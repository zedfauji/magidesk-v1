<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 8px Grid System -->
    <x:Double x:Key="SpacingXXSmall">4</x:Double>
    <x:Double x:Key="SpacingXSmall">8</x:Double>
    <x:Double x:Key="SpacingSmall">12</x:Double>
    <x:Double x:Key="SpacingMedium">16</x:Double>
    <x:Double x:Key="SpacingLarge">24</x:Double>
    <x:Double x:Key="SpacingXLarge">32</x:Double>
    <x:Double x:Key="SpacingXXLarge">48</x:Double>

    <!-- Standard Margin Values -->
    <Thickness x:Key="MarginXXSmall">4</Thickness>
    <Thickness x:Key="MarginXSmall">8</Thickness>
    <Thickness x:Key="MarginSmall">12</Thickness>
    <Thickness x:Key="MarginMedium">16</Thickness>
    <Thickness x:Key="MarginLarge">24</Thickness>
    <Thickness x:Key="MarginXLarge">32</Thickness>
    <Thickness x:Key="MarginXXLarge">48</Thickness>

    <!-- Standard Padding Values -->
    <Thickness x:Key="PaddingXXSmall">4</Thickness>
    <Thickness x:Key="PaddingXSmall">8</Thickness>
    <Thickness x:Key="PaddingSmall">12</Thickness>
    <Thickness x:Key="PaddingMedium">16</Thickness>
    <Thickness x:Key="PaddingLarge">24</Thickness>
    <Thickness x:Key="PaddingXLarge">32</Thickness>
    <Thickness x:Key="PaddingXXLarge">48</Thickness>

    <!-- Directional Margins (Top, Bottom, Left, Right) -->
    <Thickness x:Key="MarginTopXSmall">0,8,0,0</Thickness>
    <Thickness x:Key="MarginTopSmall">0,12,0,0</Thickness>
    <Thickness x:Key="MarginTopMedium">0,16,0,0</Thickness>
    <Thickness x:Key="MarginTopLarge">0,24,0,0</Thickness>

    <Thickness x:Key="MarginBottomXSmall">0,0,0,8</Thickness>
    <Thickness x:Key="MarginBottomSmall">0,0,0,12</Thickness>
    <Thickness x:Key="MarginBottomMedium">0,0,0,16</Thickness>
    <Thickness x:Key="MarginBottomLarge">0,0,0,24</Thickness>

    <Thickness x:Key="MarginLeftXSmall">8,0,0,0</Thickness>
    <Thickness x:Key="MarginLeftSmall">12,0,0,0</Thickness>
    <Thickness x:Key="MarginLeftMedium">16,0,0,0</Thickness>
    <Thickness x:Key="MarginLeftLarge">24,0,0,0</Thickness>

    <Thickness x:Key="MarginRightXSmall">0,0,8,0</Thickness>
    <Thickness x:Key="MarginRightSmall">0,0,12,0</Thickness>
    <Thickness x:Key="MarginRightMedium">0,0,16,0</Thickness>
    <Thickness x:Key="MarginRightLarge">0,0,24,0</Thickness>

    <!-- Horizontal and Vertical Margins -->
    <Thickness x:Key="MarginHorizontalXSmall">8,0,8,0</Thickness>
    <Thickness x:Key="MarginHorizontalSmall">12,0,12,0</Thickness>
    <Thickness x:Key="MarginHorizontalMedium">16,0,16,0</Thickness>
    <Thickness x:Key="MarginHorizontalLarge">24,0,24,0</Thickness>

    <Thickness x:Key="MarginVerticalXSmall">0,8,0,8</Thickness>
    <Thickness x:Key="MarginVerticalSmall">0,12,0,12</Thickness>
    <Thickness x:Key="MarginVerticalMedium">0,16,0,16</Thickness>
    <Thickness x:Key="MarginVerticalLarge">0,24,0,24</Thickness>

    <!-- StackPanel Spacing -->
    <x:Double x:Key="StackPanelSpacingXSmall">8</x:Double>
    <x:Double x:Key="StackPanelSpacingSmall">12</x:Double>
    <x:Double x:Key="StackPanelSpacingMedium">16</x:Double>
    <x:Double x:Key="StackPanelSpacingLarge">24</x:Double>

    <!-- Grid Row/Column Spacing -->
    <x:Double x:Key="GridSpacingXSmall">8</x:Double>
    <x:Double x:Key="GridSpacingSmall">12</x:Double>
    <x:Double x:Key="GridSpacingMedium">16</x:Double>
    <x:Double x:Key="GridSpacingLarge">24</x:Double>

    <!-- Border Radius (Consistent Corner Radius) -->
    <CornerRadius x:Key="CornerRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">12</CornerRadius>

    <!-- Card Padding -->
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="CardPaddingLarge">24</Thickness>

    <!-- Page Margins -->
    <Thickness x:Key="PageMargin">24</Thickness>
    <Thickness x:Key="PageMarginLarge">32</Thickness>

    <!-- Section Spacing -->
    <x:Double x:Key="SectionSpacing">32</x:Double>
    <x:Double x:Key="SectionSpacingLarge">48</x:Double>

</ResourceDictionary>
