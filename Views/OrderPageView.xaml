<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Magidesk.Presentation.Views.OrderPageView"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Magidesk.Presentation.ViewModels"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundDarkBrush}">

    <Page.Resources>
        <!-- Merge style resources -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/SettleOrderPageColors.xaml"/>
                <ResourceDictionary Source="/Styles/SettleOrderPageTypography.xaml"/>
                <ResourceDictionary Source="/Styles/SettleOrderPageButtons.xaml"/>
                <ResourceDictionary Source="/Styles/SettleOrderPageAnimations.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Converters -->
            <d:CurrencyConverter x:Key="CurrencyConverter" xmlns:d="using:Magidesk.Presentation.Converters"/>
            <d:CountToVisibilityConverter x:Key="CountToVisibilityConverter" xmlns:d="using:Magidesk.Presentation.Converters"/>
            <d:TimeSpanConverter x:Key="TimeSpanConverter" xmlns:d="using:Magidesk.Presentation.Converters"/>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/> <!-- Header -->
            <RowDefinition Height="*"/> <!-- Main Content -->
            <RowDefinition Height="32"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="{StaticResource SurfaceDarkBrush}" Padding="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Menu Button -->
                <ColumnDefinition Width="Auto"/> <!-- Title -->
                <ColumnDefinition Width="*"/> <!-- Spacer -->
                <ColumnDefinition Width="Auto"/> <!-- Terminal Info -->
                <ColumnDefinition Width="Auto"/> <!-- User Info -->
                <ColumnDefinition Width="Auto"/> <!-- System Status -->
                <ColumnDefinition Width="Auto"/> <!-- Time -->
            </Grid.ColumnDefinitions>

            <!-- Menu Button -->
            <Button Grid.Column="0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="8"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Menu">
                <FontIcon Glyph="&#xE700;" FontSize="16"/>
            </Button>

            <!-- Title -->
            <TextBlock Grid.Column="1"
                       Text="POS - HIGH VOLUME MODE"
                       Style="{StaticResource SmallUppercaseTextStyle}"
                       VerticalAlignment="Center"
                       Margin="0,0,24,0"/>

            <!-- Terminal Info -->
            <StackPanel Grid.Column="3" 
                        Orientation="Horizontal" 
                        Spacing="4"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0">
                <TextBlock Text="TERMINAL:" 
                           Style="{StaticResource SmallUppercaseTextStyle}"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Text="{x:Bind ViewModel.TerminalName, Mode=OneWay}"
                           Style="{StaticResource SmallTextStyle}"/>
            </StackPanel>

            <!-- User Info -->
            <StackPanel Grid.Column="4" 
                        Orientation="Horizontal" 
                        Spacing="4"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0">
                <TextBlock Text="USER:" 
                           Style="{StaticResource SmallUppercaseTextStyle}"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Text="{x:Bind ViewModel.UserName, Mode=OneWay}"
                           Style="{StaticResource SmallTextStyle}"/>
            </StackPanel>

            <!-- System Status -->
            <StackPanel Grid.Column="5" 
                        Orientation="Horizontal" 
                        Spacing="4"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0">
                <TextBlock Text="SYSTEM:" 
                           Style="{StaticResource SmallUppercaseTextStyle}"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Text="{x:Bind ViewModel.SystemStatus, Mode=OneWay}"
                           Style="{StaticResource SmallTextStyle}"
                           Foreground="{StaticResource SuccessBrush}"/>
            </StackPanel>

            <!-- Time -->
            <Border Grid.Column="6"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="4"
                    Padding="8,4"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE121;" FontSize="14"/>
                    <TextBlock Text="{x:Bind ViewModel.CurrentTime, Mode=OneWay}"
                               Style="{StaticResource SmallTextStyle}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Content (Two-Column Layout) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/> <!-- Order Sidebar -->
                <ColumnDefinition Width="*"/> <!-- Product Area -->
            </Grid.ColumnDefinitions>

            <!-- Order Sidebar (Left Panel) -->
            <Grid Grid.Column="0" Background="{StaticResource SidebarDarkBrush}" Padding="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Table Selector -->
                    <RowDefinition Height="Auto"/> <!-- Search -->
                    <RowDefinition Height="Auto"/> <!-- Ticket Header -->
                    <RowDefinition Height="*"/> <!-- Order Items List -->
                    <RowDefinition Height="Auto"/> <!-- Totals -->
                    <RowDefinition Height="Auto"/> <!-- Quick Actions -->
                    <RowDefinition Height="Auto"/> <!-- Payment Buttons -->
                </Grid.RowDefinitions>

                <!-- Table Selector Button -->
                <Button Grid.Row="0"
                        Command="{x:Bind ViewModel.SelectTableCommand}"
                        Background="{StaticResource PrimaryBrush}"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,16"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Select Table">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0078D4"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#005A9E"/>
                    </Button.Resources>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Table Icon -->
                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE8EA;"
                                  FontSize="24"
                                  Margin="0,0,12,0"/>

                        <!-- Table Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="CURRENT TABLE"
                                       Style="{StaticResource SmallUppercaseTextStyle}"
                                       Opacity="0.7"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{x:Bind ViewModel.TableNumber, Mode=OneWay}"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <!-- Expand Icon -->
                        <FontIcon Grid.Column="2"
                                  Glyph="&#xE70D;"
                                  FontSize="16"/>
                    </Grid>
                </Button>

                <!-- Search Input -->
                <TextBox Grid.Row="1"
                         Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Search product or SKU..."
                         Background="{StaticResource SurfaceBrush}"
                         BorderThickness="0"
                         CornerRadius="4"
                         Padding="12,8"
                         Margin="0,0,0,16">
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#2C2C2C"/>
                    </TextBox.Resources>
                </TextBox>

                <!-- Ticket Header -->
                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{x:Bind ViewModel.TicketNumber, Mode=OneWay}"
                               Style="{StaticResource BodyBoldTextStyle}"/>

                    <Button Grid.Column="1"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="8"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="Add Guest">
                        <FontIcon Glyph="&#xE8FA;" FontSize="14"/>
                    </Button>

                    <Button Grid.Column="2"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="8"
                            AutomationProperties.Name="History">
                        <FontIcon Glyph="&#xE81C;" FontSize="14"/>
                    </Button>
                </Grid>

                <!-- Order Items List -->
                <ScrollViewer Grid.Row="3" 
                              VerticalScrollBarVisibility="Auto"
                              Margin="0,0,0,16">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.OrderItems, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:OrderItemViewModel">
                                <Border Background="{StaticResource SurfaceBrush}"
                                        CornerRadius="4"
                                        Padding="12"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Item Name and Price -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Quantity -->
                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Bind Quantity, Mode=OneWay}"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       FontWeight="Bold"
                                                       Margin="0,0,8,0"/>

                                            <!-- Product Name -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind ProductName, Mode=OneWay}"
                                                       Style="{StaticResource BodyTextStyle}"
                                                       TextWrapping="Wrap"/>

                                            <!-- Line Total -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{x:Bind LineTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                                                       Style="{StaticResource BodyTextStyle}"
                                                       FontWeight="SemiBold"/>
                                        </Grid>

                                        <!-- Modifiers -->
                                        <ItemsControl Grid.Row="1"
                                                      ItemsSource="{x:Bind Modifiers, Mode=OneWay}"
                                                      Margin="24,4,0,0"
                                                      Visibility="{x:Bind HasModifiers, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{x:Bind}"
                                                               Style="{StaticResource SmallTextStyle}"
                                                               FontStyle="Italic"
                                                               Opacity="0.7"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Edit/Remove Buttons -->
                                        <StackPanel Grid.Row="2"
                                                    Orientation="Horizontal"
                                                    Spacing="12"
                                                    Margin="24,8,0,0"
                                                    Visibility="{x:Bind HasModifiers, Mode=OneWay}">
                                            <HyperlinkButton Content="Edit"
                                                             Command="{Binding DataContext.EditOrderItemCommand, ElementName=Page}"
                                                             CommandParameter="{x:Bind}"
                                                             Padding="0"
                                                             FontSize="12"/>
                                            <HyperlinkButton Content="Remove"
                                                             Command="{Binding DataContext.RemoveOrderItemCommand, ElementName=Page}"
                                                             CommandParameter="{x:Bind}"
                                                             Padding="0"
                                                             FontSize="12"
                                                             Foreground="{StaticResource ErrorBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Totals Section -->
                <Border Grid.Row="4"
                        Background="{StaticResource SurfaceDarkBrush}"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Subtotal -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="SUBTOTAL"
                                       Style="{StaticResource SmallUppercaseTextStyle}"
                                       Opacity="0.7"/>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.Subtotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                                       Style="{StaticResource BodyTextStyle}"
                                       Opacity="0.7"/>
                        </Grid>

                        <!-- Tax -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="TAX (8%)"
                                       Style="{StaticResource SmallUppercaseTextStyle}"
                                       Opacity="0.7"/>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.TaxAmount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                                       Style="{StaticResource BodyTextStyle}"
                                       Opacity="0.7"/>
                        </Grid>

                        <!-- Total -->
                        <Grid Grid.Row="2" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="TOTAL"
                                       Style="{StaticResource SmallUppercaseTextStyle}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.Total, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                                       FontSize="24"
                                       FontWeight="Black"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Quick Action Buttons -->
                <Grid Grid.Row="5" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Split -->
                    <Button Grid.Column="0"
                            Command="{x:Bind ViewModel.SplitOrderCommand}"
                            Style="{StaticResource QuickActionButtonStyle}"
                            Margin="0,0,4,0">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xF0E7;" FontSize="16"/>
                            <TextBlock Text="SPLIT" Style="{StaticResource TinyUppercaseTextStyle}"/>
                        </StackPanel>
                    </Button>

                    <!-- Merge -->
                    <Button Grid.Column="1"
                            Command="{x:Bind ViewModel.MergeOrderCommand}"
                            Style="{StaticResource QuickActionButtonStyle}"
                            Margin="4,0,4,0">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE8A0;" FontSize="16"/>
                            <TextBlock Text="MERGE" Style="{StaticResource TinyUppercaseTextStyle}"/>
                        </StackPanel>
                    </Button>

                    <!-- Note -->
                    <Button Grid.Column="2"
                            Command="{x:Bind ViewModel.AddNoteCommand}"
                            Style="{StaticResource QuickActionButtonStyle}"
                            Margin="4,0,4,0">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE70B;" FontSize="16"/>
                            <TextBlock Text="NOTE" Style="{StaticResource TinyUppercaseTextStyle}"/>
                        </StackPanel>
                    </Button>

                    <!-- Print -->
                    <Button Grid.Column="3"
                            Command="{x:Bind ViewModel.PrintOrderCommand}"
                            Style="{StaticResource QuickActionButtonStyle}"
                            Margin="4,0,0,0">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE749;" FontSize="16"/>
                            <TextBlock Text="PRINT" Style="{StaticResource TinyUppercaseTextStyle}"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Payment Buttons -->
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- SETTLE Button -->
                    <Button Grid.Column="0"
                            Command="{x:Bind ViewModel.NavigateToSettleCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="56"
                            Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8C7;" FontSize="18"/>
                            <TextBlock Text="SETTLE" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <!-- PAY NOW Button -->
                    <Button Grid.Column="1"
                            Command="{x:Bind ViewModel.PayNowCommand}"
                            Background="{StaticResource SuccessBrush}"
                            Height="56"
                            CornerRadius="8"
                            Margin="4,0,0,0">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0E8A1E"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0C7519"/>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8A1;" FontSize="18"/>
                            <TextBlock Text="PAY NOW" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <!-- Product Area (Right Panel) -->
            <Grid Grid.Column="1" Background="{StaticResource BackgroundDarkBrush}" Padding="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Category Tabs -->
                    <RowDefinition Height="Auto"/> <!-- Subcategory Pills -->
                    <RowDefinition Height="*"/> <!-- Product Grid -->
                </Grid.RowDefinitions>

                <!-- Category Tabs -->
                <ScrollViewer Grid.Row="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="0,0,0,16">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:ProductCategoryViewModel">
                                <Button Command="{Binding DataContext.SelectCategoryCommand, ElementName=Page}"
                                        CommandParameter="{x:Bind}"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderThickness="0"
                                        CornerRadius="8"
                                        Padding="16,12"
                                        MinWidth="120">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#3C3C3C"/>
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#4C4C4C"/>
                                    </Button.Resources>
                                    <StackPanel Spacing="8">
                                        <FontIcon Glyph="{x:Bind IconName}" FontSize="20"/>
                                        <TextBlock Text="{x:Bind Name}"
                                                   Style="{StaticResource SmallTextStyle}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Subcategory Filter Pills -->
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="0,0,0,16"
                              Visibility="{x:Bind ViewModel.Subcategories.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Subcategories, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Command="{Binding DataContext.SelectSubcategoryCommand, ElementName=Page}"
                                        CommandParameter="{x:Bind}"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource PrimaryBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="16,8"
                                        Height="36">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0078D4"/>
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#005A9E"/>
                                    </Button.Resources>
                                    <TextBlock Text="{x:Bind}"
                                               Style="{StaticResource SmallTextStyle}"
                                               FontWeight="SemiBold"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Product Grid -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.FilteredProducts, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"
                                               ItemWidth="180"
                                               ItemHeight="128"
                                               HorizontalAlignment="Left"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:ProductViewModel">
                                <Button Command="{Binding DataContext.AddProductCommand, ElementName=Page}"
                                        CommandParameter="{x:Bind}"
                                        Background="{StaticResource SurfaceDarkBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,0,12,12"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#0078D4"/>
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2C2C2C"/>
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3C3C3C"/>
                                    </Button.Resources>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Product Name -->
                                        <TextBlock Grid.Row="0"
                                                   Text="{x:Bind Name}"
                                                   Style="{StaticResource SmallTextStyle}"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Top"/>

                                        <!-- Price and Add Icon -->
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Price -->
                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Bind Price, Converter={StaticResource CurrencyConverter}}"
                                                       Style="{StaticResource SmallTextStyle}"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       VerticalAlignment="Bottom"/>

                                            <!-- Add Icon (visible on hover) -->
                                            <FontIcon Grid.Column="1"
                                                      Glyph="&#xE710;"
                                                      FontSize="20"
                                                      Foreground="{StaticResource PrimaryBrush}"
                                                      VerticalAlignment="Bottom"
                                                      Opacity="0">
                                                <FontIcon.Transitions>
                                                    <TransitionCollection>
                                                        <RepositionThemeTransition/>
                                                    </TransitionCollection>
                                                </FontIcon.Transitions>
                                            </FontIcon>
                                        </Grid>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Background="{StaticResource SurfaceDarkBrush}" Padding="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Status Indicator -->
                <ColumnDefinition Width="Auto"/> <!-- Station Info -->
                <ColumnDefinition Width="16"/> <!-- Spacer -->
                <ColumnDefinition Width="Auto"/> <!-- Session Controls -->
                <ColumnDefinition Width="16"/> <!-- Spacer -->
                <ColumnDefinition Width="Auto"/> <!-- Divider -->
                <ColumnDefinition Width="16"/> <!-- Spacer -->
                <ColumnDefinition Width="Auto"/> <!-- Advanced Operations -->
                <ColumnDefinition Width="*"/> <!-- Spacer -->
                <ColumnDefinition Width="Auto"/> <!-- Order Statistics -->
                <ColumnDefinition Width="16"/> <!-- Spacer -->
                <ColumnDefinition Width="Auto"/> <!-- Copyright -->
            </Grid.ColumnDefinitions>

            <!-- Status Indicator -->
            <Ellipse Grid.Column="0"
                     Width="8"
                     Height="8"
                     Fill="{StaticResource SuccessBrush}"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0"/>

            <!-- Station Info -->
            <TextBlock Grid.Column="1"
                       Text="Station 1"
                       Style="{StaticResource SmallTextStyle}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center"/>

            <!-- Session Controls -->
            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <!-- Start Session -->
                <Button Command="{x:Bind ViewModel.StartSessionCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="12,6"
                        Height="24">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE768;" FontSize="12"/>
                        <TextBlock Text="START SESSION" Style="{StaticResource TinyUppercaseTextStyle}"/>
                    </StackPanel>
                </Button>

                <!-- End Session -->
                <Button Command="{x:Bind ViewModel.EndSessionCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="12,6"
                        Height="24">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE71A;" FontSize="12"/>
                        <TextBlock Text="END SESSION" Style="{StaticResource TinyUppercaseTextStyle}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Vertical Divider -->
            <Border Grid.Column="5"
                    Width="1"
                    Background="{StaticResource BorderBrush}"
                    VerticalAlignment="Stretch"
                    Margin="0,4"/>

            <!-- Advanced Operations -->
            <ScrollViewer Grid.Column="7"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <!-- Reprint -->
                    <Button Command="{x:Bind ViewModel.ReprintCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,6"
                            Height="24">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0078D4"/>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8A1;" FontSize="12"/>
                            <TextBlock Text="REPRINT" Style="{StaticResource TinyUppercaseTextStyle}"/>
                        </StackPanel>
                    </Button>

                    <!-- Void -->
                    <Button Command="{x:Bind ViewModel.VoidTicketCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,6"
                            Height="24">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#D13438"/>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE711;" FontSize="12"/>
                            <TextBlock Text="VOID" Style="{StaticResource TinyUppercaseTextStyle}"/>
                        </StackPanel>
                    </Button>

                    <!-- Discount -->
                    <Button Command="{x:Bind ViewModel.ApplyDiscountCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,6"
                            Height="24">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF8C00"/>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8C8;" FontSize="12"/>
                            <TextBlock Text="DISCOUNT" Style="{StaticResource TinyUppercaseTextStyle}"/>
                        </StackPanel>
                    </Button>

                    <!-- Fire Ticket -->
                    <Button Command="{x:Bind ViewModel.FireTicketCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,6"
                            Height="24">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#6A5ACD"/>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8EA;" FontSize="12"/>
                            <TextBlock Text="FIRE TICKET" Style="{StaticResource TinyUppercaseTextStyle}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- Order Statistics -->
            <StackPanel Grid.Column="9"
                        Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center">
                <TextBlock Style="{StaticResource SmallTextStyle}"
                           Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="Items:"/>
                    <Run Text="{x:Bind ViewModel.TotalItemCount, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>
                <TextBlock Style="{StaticResource SmallTextStyle}"
                           Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="Wait:"/>
                    <Run Text="{x:Bind ViewModel.WaitTime, Mode=OneWay, Converter={StaticResource TimeSpanConverter}}" FontWeight="Bold"/>
                </TextBlock>
            </StackPanel>

            <!-- Copyright -->
            <TextBlock Grid.Column="11"
                       Text="© 2026 Magidesk POS"
                       Style="{StaticResource SmallTextStyle}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Loading Indicator Overlay -->
        <Grid Grid.RowSpan="3" 
              Background="#80000000" 
              Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="60" Height="60"/>
                <TextBlock Text="Loading..." 
                           Style="{StaticResource SubtitleTextBlockStyle}" 
                           HorizontalAlignment="Center"
                           Foreground="White"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
