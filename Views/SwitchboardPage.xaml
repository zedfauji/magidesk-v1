<Page
    x:Class="Magidesk.Presentation.Views.SwitchboardPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Magidesk.Presentation.ViewModels"
    xmlns:services="using:Magidesk.Presentation.Services"
    xmlns:converters="using:Magidesk.Presentation.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Converters -->
        <converters:StringVisibilityConverter x:Key="StringVisibilityConverter"/>
        
        <!-- Navigation Button Style -->
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="120"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#5A5A5A"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" 
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="#707070"/>
                                            <Setter Target="RootGrid.BorderBrush" Value="#0078D4"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="#0078D4"/>
                                            <Setter Target="RootGrid.BorderBrush" Value="#0078D4"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="#3A3A3A"/>
                                            <Setter Target="RootGrid.BorderBrush" Value="#505050"/>
                                            <Setter Target="ContentPresenter.Opacity" Value="0.4"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="ContentPresenter"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            Padding="{TemplateBinding Padding}"
                                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <Grid Padding="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header: User Context and Status Information -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Application Title -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="MAGIDESK POS" 
                               Style="{StaticResource TitleTextBlockStyle}"
                               FontWeight="Bold"/>
                </StackPanel>

                <!-- Right: User Context and Live Counts -->
                <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="User:" 
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.CurrentUserName, Mode=OneWay}" 
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Terminal:" 
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.TerminalId, Mode=OneWay}" 
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Shift:" 
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.ShiftStatus, Mode=OneWay}" 
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}" 
                                CornerRadius="4" 
                                Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8A1;" 
                                          FontSize="16" 
                                          Foreground="White"/>
                                <TextBlock Text="Open Tickets:" 
                                           Foreground="White" 
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind ViewModel.OpenTicketCount, Mode=OneWay}" 
                                           Foreground="White" 
                                           FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource SystemFillColorSuccessBrush}" 
                                CornerRadius="4" 
                                Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE916;" 
                                          FontSize="16" 
                                          Foreground="White"/>
                                <TextBlock Text="Active Sessions:" 
                                           Foreground="White" 
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind ViewModel.ActiveSessionCount, Mode=OneWay}" 
                                           Foreground="White" 
                                           FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Main Navigation Buttons -->
            <StackPanel Grid.Row="1" Spacing="32">
                <!-- Operations Section -->
                <StackPanel Spacing="16">
                    <TextBlock Text="OPERATIONS" 
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    
                    <ItemsControl ItemsSource="{x:Bind ViewModel.NavigationButtons, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:NavigationButton">
                                <Button Style="{StaticResource NavigationButtonStyle}"
                                        Command="{Binding DataContext.NavigateCommand, ElementName=RootPage}"
                                        CommandParameter="{x:Bind Route}"
                                        IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind Label}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Icon -->
                                        <FontIcon Grid.Row="0" 
                                                  Glyph="{x:Bind Icon}" 
                                                  FontSize="32"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>

                                        <!-- Label -->
                                        <TextBlock Grid.Row="1" 
                                                   Text="{x:Bind Label}" 
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Margin="0,8,0,0"
                                                   HorizontalAlignment="Center"/>

                                        <!-- Keyboard Shortcut -->
                                        <TextBlock Grid.Row="2" 
                                                   Text="{x:Bind KeyboardShortcut}" 
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextAlignment="Center"
                                                   Margin="0,4,0,0"
                                                   HorizontalAlignment="Center"
                                                   Visibility="{x:Bind KeyboardShortcut, Converter={StaticResource StringVisibilityConverter}}"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
