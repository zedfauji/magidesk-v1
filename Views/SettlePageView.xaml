<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Magidesk.Presentation.Views.SettlePageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Magidesk.Presentation.ViewModels"
    xmlns:enums="using:Magidesk.Domain.Enumerations"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundDarkBrush}">

    <Page.Resources>
        <!-- Merge style resources -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/SettleOrderPageColors.xaml"/>
                <ResourceDictionary Source="/Styles/SettleOrderPageTypography.xaml"/>
                <ResourceDictionary Source="/Styles/SettleOrderPageButtons.xaml"/>
                <ResourceDictionary Source="/Styles/SettleOrderPageAnimations.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Converters -->
            <d:CurrencyConverter x:Key="CurrencyConverter" xmlns:d="using:Magidesk.Presentation.Converters"/>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/> <!-- Header -->
            <RowDefinition Height="*"/> <!-- Main Content -->
            <RowDefinition Height="48"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="{StaticResource SurfaceDarkBrush}" Padding="24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Back Button -->
                <ColumnDefinition Width="*"/> <!-- Title and Ticket Info -->
                <ColumnDefinition Width="Auto"/> <!-- Tax Exempt Button -->
                <ColumnDefinition Width="Auto"/> <!-- Settings Button -->
            </Grid.ColumnDefinitions>

            <!-- Back Button -->
            <Button Grid.Column="0"
                    Command="{x:Bind ViewModel.NavigateBackCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="12"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Back">
                <SymbolIcon Symbol="Back"/>
            </Button>

            <!-- Title and Ticket Info -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="SETTLE PAYMENT" 
                           Style="{StaticResource SmallUppercaseTextStyle}"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.TicketNumber, Mode=OneWay}"
                               Style="{StaticResource BodyBoldTextStyle}"/>
                    <TextBlock Text="•" 
                               Style="{StaticResource BodyTextStyle}"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.TableNumber, Mode=OneWay}"
                               Style="{StaticResource BodyBoldTextStyle}"/>
                </StackPanel>
            </StackPanel>

            <!-- Tax Exempt Button -->
            <Button Grid.Column="2"
                    Command="{x:Bind ViewModel.ToggleTaxExemptCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Tax Exempt">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8F1;" FontSize="16"/>
                    <TextBlock Text="Tax Exempt"/>
                </StackPanel>
            </Button>

            <!-- Settings Button -->
            <Button Grid.Column="3"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="12"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Settings">
                <SymbolIcon Symbol="Setting"/>
            </Button>
        </Grid>

        <!-- Main Content (Three-Column Layout) -->
        <Grid Grid.Row="1" Padding="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/> <!-- Ticket Summary -->
                <ColumnDefinition Width="24"/> <!-- Spacing -->
                <ColumnDefinition Width="*"/> <!-- Tender Entry -->
                <ColumnDefinition Width="24"/> <!-- Spacing -->
                <ColumnDefinition Width="320"/> <!-- Payment Actions -->
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Ticket Summary -->
            <Grid Grid.Column="0" Background="{StaticResource SurfaceDarkBrush}" 
                  CornerRadius="12" Padding="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/> <!-- Financial Summary -->
                    <RowDefinition Height="Auto"/> <!-- Cancel Button -->
                </Grid.RowDefinitions>

                <!-- Financial Summary -->
                <StackPanel Grid.Row="0" Spacing="20" VerticalAlignment="Top">
                    <!-- Total Amount -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Total Amount" 
                                   Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.TotalAmount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                                   Style="{StaticResource HeadingXLTextStyle}"/>
                    </StackPanel>

                    <!-- Tax Amount -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Tax Amount" 
                                   Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.TaxAmount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                                   Style="{StaticResource HeadingXLTextStyle}"/>
                    </StackPanel>

                    <!-- Paid Amount (Green) -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Paid Amount" 
                                   Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.PaidAmount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                                   Style="{StaticResource HeadingXLTextStyle}"
                                   Foreground="{StaticResource AccentGreenBrush}"/>
                    </StackPanel>

                    <!-- Separator -->
                    <Border Height="1" 
                            Background="{StaticResource BorderDefaultBrush}"
                            Margin="0,12,0,0"/>

                    <!-- Balance Due (Prominent) -->
                    <StackPanel Spacing="8" Margin="0,12,0,0">
                        <TextBlock Text="BALANCE DUE" 
                                   Style="{StaticResource LabelUppercaseTextStyle}"
                                   Foreground="{StaticResource PrimaryBlueBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.BalanceDue, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                                   Style="{StaticResource Display4XLTextStyle}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Cancel Settlement Button -->
                <Button Grid.Row="1"
                        Command="{x:Bind ViewModel.CancelSettlementCommand}"
                        Style="{StaticResource CancelButtonStyle}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="Cancel Settlement">
                    <TextBlock Text="Cancel Settlement" TextAlignment="Center"/>
                </Button>
            </Grid>

            <!-- Center Panel: Tender Entry -->
            <Grid Grid.Column="2">
                <StackPanel Spacing="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Tender Amount Display -->
                    <Border Background="{StaticResource SurfaceDarkBrush}"
                            BorderBrush="{StaticResource BorderDefaultBrush}"
                            BorderThickness="2"
                            CornerRadius="12"
                            Padding="32,24"
                            MinWidth="400">
                        <StackPanel Spacing="8">
                            <TextBlock Text="TENDER AMOUNT" 
                                       Style="{StaticResource XSmallUppercaseTextStyle}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.TenderAmountDisplay, Mode=OneWay}"
                                       Style="{StaticResource Display6XLTextStyle}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Numeric Keypad (3x4 Grid) -->
                    <Grid MaxWidth="400">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Row 1: 7, 8, 9 -->
                        <Button Grid.Row="0" Grid.Column="0"
                                Command="{x:Bind ViewModel.KeypadDigitCommand}"
                                CommandParameter="7"
                                Style="{StaticResource KeypadButtonStyle}"
                                Margin="4"
                                AutomationProperties.Name="Seven">
                            <TextBlock Text="7"/>
                        </Button>
                        <Button Grid.Row="0" Grid.Column="1"
                                Command="{x:Bind ViewModel.KeypadDigitCommand}"
                                CommandParameter="8"
                                Style="{StaticResource KeypadButtonStyle}"
                                Margin="4"
                                AutomationProperties.Name="Eight">
                            <TextBlock Text="8"/>
                        </Button>
                        <Button Grid.Row="0" Grid.Column="2"
                                Command="{x:Bind ViewModel.KeypadDigitCommand}"
                                CommandParameter="9"
                                Style="{StaticResource KeypadButtonStyle}"
                                Margin="4"
                                AutomationProperties.Name="Nine">
                            <TextBlock Text="9"/>
                        </Button>

                        <!-- Row 2: 4, 5, 6 -->
                        <Button Grid.Row="1" Grid.Column="0"
                                Command="{x:Bind ViewModel.KeypadDigitCommand}"
                                CommandParameter="4"
                                Style="{StaticResource KeypadButtonStyle}"
                                Margin="4"
                                AutomationProperties.Name="Four">
                            <TextBlock Text="4"/>
                        </Button>
                        <Button Grid.Row="1" Grid.Column="1"
                                Command="{x:Bind ViewModel.KeypadDigitCommand}"
                                CommandParameter="5"
                                Style="{StaticResource KeypadButtonStyle}"
                                Margin="4"
                                AutomationProperties.Name="Five">
                            <TextBlock Text="5"/>
                        </Button>
                        <Button Grid.Row="1" Grid.Column="2"
                                Command="{x:Bind ViewModel.KeypadDigitCommand}"
                                CommandParameter="6"
                                Style="{StaticResource KeypadButtonStyle}"
                                Margin="4"
                                AutomationProperties.Name="Six">
                            <TextBlock Text="6"/>
                        </Button>

                        <!-- Row 3: 1, 2, 3 -->
                        <Button Grid.Row="2" Grid.Column="0"
                                Command="{x:Bind ViewModel.KeypadDigitCommand}"
                                CommandParameter="1"
                                Style="{StaticResource KeypadButtonStyle}"
                                Margin="4"
                                AutomationProperties.Name="One">
                            <TextBlock Text="1"/>
                        </Button>
                        <Button Grid.Row="2" Grid.Column="1"
                                Command="{x:Bind ViewModel.KeypadDigitCommand}"
                                CommandParameter="2"
                                Style="{StaticResource KeypadButtonStyle}"
                                Margin="4"
                                AutomationProperties.Name="Two">
                            <TextBlock Text="2"/>
                        </Button>
                        <Button Grid.Row="2" Grid.Column="2"
                                Command="{x:Bind ViewModel.KeypadDigitCommand}"
                                CommandParameter="3"
                                Style="{StaticResource KeypadButtonStyle}"
                                Margin="4"
                                AutomationProperties.Name="Three">
                            <TextBlock Text="3"/>
                        </Button>

                        <!-- Row 4: C, 0, . -->
                        <Button Grid.Row="3" Grid.Column="0"
                                Command="{x:Bind ViewModel.ClearTenderCommand}"
                                Style="{StaticResource KeypadClearButtonStyle}"
                                Margin="4"
                                AutomationProperties.Name="Clear">
                            <TextBlock Text="C"/>
                        </Button>
                        <Button Grid.Row="3" Grid.Column="1"
                                Command="{x:Bind ViewModel.KeypadDigitCommand}"
                                CommandParameter="0"
                                Style="{StaticResource KeypadButtonStyle}"
                                Margin="4"
                                AutomationProperties.Name="Zero">
                            <TextBlock Text="0"/>
                        </Button>
                        <Button Grid.Row="3" Grid.Column="2"
                                Command="{x:Bind ViewModel.KeypadDigitCommand}"
                                CommandParameter="."
                                Style="{StaticResource KeypadButtonStyle}"
                                Margin="4"
                                AutomationProperties.Name="Decimal Point">
                            <TextBlock Text="."/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Right Panel: Payment Actions -->
            <Grid Grid.Column="4" Background="{StaticResource SurfaceDarkBrush}" 
                  CornerRadius="12" Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20">
                        <!-- ADD TIP Button (Prominent) -->
                        <Button Command="{x:Bind ViewModel.AddTipCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Padding="20,16"
                                AutomationProperties.Name="Add Tip">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE76E;" FontSize="20"/>
                                <TextBlock Text="ADD TIP" 
                                           FontSize="{StaticResource FontSizeLG}"
                                           FontWeight="{StaticResource FontWeightBold}"/>
                            </StackPanel>
                        </Button>

                        <!-- Action Buttons Grid (2x2) -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Hold Ticket -->
                            <Button Grid.Row="0" Grid.Column="0"
                                    Command="{x:Bind ViewModel.HoldTicketCommand}"
                                    Style="{StaticResource QuickActionButtonStyle}"
                                    Margin="0,0,4,4"
                                    AutomationProperties.Name="Hold Ticket">
                                <StackPanel Spacing="4">
                                    <FontIcon Glyph="&#xE769;" FontSize="16"/>
                                    <TextBlock Text="HOLD TICKET" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Split Payment -->
                            <Button Grid.Row="0" Grid.Column="1"
                                    Command="{x:Bind ViewModel.SplitPaymentCommand}"
                                    Style="{StaticResource QuickActionButtonStyle}"
                                    Margin="4,0,0,4"
                                    AutomationProperties.Name="Split Payment">
                                <StackPanel Spacing="4">
                                    <FontIcon Glyph="&#xE8F8;" FontSize="16"/>
                                    <TextBlock Text="SPLIT PMT" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Discount -->
                            <Button Grid.Row="1" Grid.Column="0"
                                    Command="{x:Bind ViewModel.ApplyDiscountCommand}"
                                    Style="{StaticResource QuickActionButtonStyle}"
                                    Margin="0,4,4,0"
                                    AutomationProperties.Name="Apply Discount">
                                <StackPanel Spacing="4">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="16"/>
                                    <TextBlock Text="DISCOUNT" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Receipt -->
                            <Button Grid.Row="1" Grid.Column="1"
                                    Command="{x:Bind ViewModel.PrintReceiptCommand}"
                                    Style="{StaticResource QuickActionButtonStyle}"
                                    Margin="4,4,0,0"
                                    AutomationProperties.Name="Print Receipt">
                                <StackPanel Spacing="4">
                                    <FontIcon Glyph="&#xE749;" FontSize="16"/>
                                    <TextBlock Text="RECEIPT" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Divider -->
                        <Border Height="1" Background="{StaticResource BorderDefaultBrush}"/>

                        <!-- Quick Cash Section -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="QUICK CASH" 
                                       Style="{StaticResource LabelUppercaseTextStyle}"/>
                            
                            <!-- Quick Cash Grid (3x2) -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Row 1: $1, $5, $10 -->
                                <Button Grid.Row="0" Grid.Column="0"
                                        Click="QuickCash1_Click"
                                        Style="{StaticResource QuickCashButtonStyle}"
                                        Margin="0,0,4,4"
                                        AutomationProperties.Name="One Dollar">
                                    <TextBlock Text="$1"/>
                                </Button>
                                <Button Grid.Row="0" Grid.Column="1"
                                        Click="QuickCash5_Click"
                                        Style="{StaticResource QuickCashButtonStyle}"
                                        Margin="4,0,4,4"
                                        AutomationProperties.Name="Five Dollars">
                                    <TextBlock Text="$5"/>
                                </Button>
                                <Button Grid.Row="0" Grid.Column="2"
                                        Click="QuickCash10_Click"
                                        Style="{StaticResource QuickCashButtonStyle}"
                                        Margin="4,0,0,4"
                                        AutomationProperties.Name="Ten Dollars">
                                    <TextBlock Text="$10"/>
                                </Button>

                                <!-- Row 2: $20, $50, $100 -->
                                <Button Grid.Row="1" Grid.Column="0"
                                        Click="QuickCash20_Click"
                                        Style="{StaticResource QuickCashButtonStyle}"
                                        Margin="0,4,4,0"
                                        AutomationProperties.Name="Twenty Dollars">
                                    <TextBlock Text="$20"/>
                                </Button>
                                <Button Grid.Row="1" Grid.Column="1"
                                        Click="QuickCash50_Click"
                                        Style="{StaticResource QuickCashButtonStyle}"
                                        Margin="4,4,4,0"
                                        AutomationProperties.Name="Fifty Dollars">
                                    <TextBlock Text="$50"/>
                                </Button>
                                <Button Grid.Row="1" Grid.Column="2"
                                        Click="QuickCash100_Click"
                                        Style="{StaticResource QuickCashButtonStyle}"
                                        Margin="4,4,0,0"
                                        AutomationProperties.Name="One Hundred Dollars">
                                    <TextBlock Text="$100"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Payment Method Buttons -->
                        <StackPanel Spacing="12">
                            <!-- Cash Payment -->
                            <Button Command="{x:Bind ViewModel.ProcessPaymentCommand}"
                                    CommandParameter="{x:Bind enums:PaymentType.Cash}"
                                    Style="{StaticResource CashPaymentButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Pay with Cash">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE8D0;" FontSize="20" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="CASH" 
                                               FontSize="{StaticResource FontSizeLG}"
                                               FontWeight="{StaticResource FontWeightBold}"
                                               VerticalAlignment="Center"/>
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="16"/>
                                </Grid>
                            </Button>

                            <!-- Credit Card Payment -->
                            <Button Command="{x:Bind ViewModel.ProcessPaymentCommand}"
                                    CommandParameter="{x:Bind enums:PaymentType.CreditCard}"
                                    Style="{StaticResource CreditCardPaymentButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Pay with Credit Card">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE8C7;" FontSize="20" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="CREDIT CARD" 
                                               FontSize="{StaticResource FontSizeLG}"
                                               FontWeight="{StaticResource FontWeightBold}"
                                               VerticalAlignment="Center"/>
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="16"/>
                                </Grid>
                            </Button>

                            <!-- Gift Card Payment -->
                            <Button Command="{x:Bind ViewModel.ProcessPaymentCommand}"
                                    CommandParameter="{x:Bind enums:PaymentType.GiftCertificate}"
                                    Style="{StaticResource GiftCardPaymentButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Pay with Gift Card">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE8F6;" FontSize="20" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="GIFT CARD" 
                                               FontSize="{StaticResource FontSizeLG}"
                                               FontWeight="{StaticResource FontWeightBold}"
                                               VerticalAlignment="Center"/>
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="16"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Background="{StaticResource SurfaceDarkBrush}" Padding="24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Terminal and User Info -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="TERMINAL:" Style="{StaticResource XSmallUppercaseTextStyle}"/>
                    <TextBlock Text="POS-01" Style="{StaticResource SmallTextStyle}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="USER:" Style="{StaticResource XSmallUppercaseTextStyle}"/>
                    <TextBlock Text="Admin" Style="{StaticResource SmallTextStyle}"/>
                </StackPanel>
            </StackPanel>

            <!-- Cash Balance -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="CASH BALANCE:" Style="{StaticResource XSmallUppercaseTextStyle}"/>
                    <TextBlock Text="$1,250.00" Style="{StaticResource SmallTextStyle}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE121;" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="12:45 PM" Style="{StaticResource SmallTextStyle}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Loading Indicator Overlay -->
        <Grid Grid.RowSpan="3" 
              Background="#80000000" 
              Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="60" Height="60"/>
                <TextBlock Text="Processing..." 
                           Style="{StaticResource SubtitleTextBlockStyle}" 
                           HorizontalAlignment="Center"
                           Foreground="White"/>
            </StackPanel>
        </Grid>

        <!-- Payment Processing Indicator -->
        <Grid Grid.RowSpan="3" 
              Background="#80000000" 
              Visibility="{x:Bind ViewModel.IsProcessingPayment, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="60" Height="60"/>
                <TextBlock Text="Processing Payment..." 
                           Style="{StaticResource SubtitleTextBlockStyle}" 
                           HorizontalAlignment="Center"
                           Foreground="White"/>
                <TextBlock Text="Please wait..." 
                           Style="{StaticResource CaptionTextBlockStyle}" 
                           HorizontalAlignment="Center"
                           Foreground="#CCFFFFFF"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
