<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Magidesk.Presentation.Views.TableSessionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Magidesk.Presentation.Controls"
    xmlns:dto="using:Magidesk.Application.DTOs"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="24,16,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <TextBlock Text="Table Session Management" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="Control and monitor active table sessions" 
                           Style="{StaticResource CaptionTextBlockStyle}" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                <Button Content="Refresh" 
                        Command="{x:Bind ViewModel.LoadSessionsCommand}"
                        Style="{StaticResource AccentButtonStyle}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5"/>
                    </Button.KeyboardAccelerators>
                </Button>
                <ToggleButton Content="Real-Time" 
                              IsChecked="{x:Bind ViewModel.IsRealTimeEnabled, Mode=TwoWay}"
                              Command="{x:Bind ViewModel.ToggleRealTimeCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Statistics Dashboard -->
        <Grid Grid.Row="1" Padding="24,8,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Active Sessions -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="8" Padding="16" Margin="0,0,8,0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.TotalActiveSessions, Mode=OneWay}" 
                               Style="{StaticResource HeaderTextBlockStyle}" 
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock Text="Active Sessions" Style="{StaticResource CaptionTextBlockStyle}"/>
                </StackPanel>
            </Border>

            <!-- Paused Sessions -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="8" Padding="16" Margin="4,0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.PausedSessions, Mode=OneWay}" 
                               Style="{StaticResource HeaderTextBlockStyle}" 
                               Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                    <TextBlock Text="Paused Sessions" Style="{StaticResource CaptionTextBlockStyle}"/>
                </StackPanel>
            </Border>

            <!-- Total Revenue -->
            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="8" Padding="16" Margin="8,0,0,0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.TotalRevenue, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" 
                               Style="{StaticResource HeaderTextBlockStyle}" 
                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                    <TextBlock Text="Total Revenue" Style="{StaticResource CaptionTextBlockStyle}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="2" Padding="24,0,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sessions List -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- List Header -->
                <TextBlock Grid.Row="0" 
                           Text="Active Sessions" 
                           Style="{StaticResource SubtitleTextBlockStyle}" 
                           Margin="0,0,0,12"/>

                <!-- Sessions ListView -->
                <ListView Grid.Row="1" 
                          x:Name="SessionsList"
                          ItemsSource="{x:Bind ViewModel.ActiveSessions, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="dto:ActiveSessionDto">
                            <Grid Padding="16" 
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                  CornerRadius="8" 
                                  Margin="0,4"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  BorderThickness="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Status Indicator -->
                                <Border Grid.Column="0" Grid.RowSpan="3" 
                                        Width="4" CornerRadius="2" Margin="0,0,16,0"
                                        Background="{x:Bind Status, Converter={StaticResource SessionStatusToBrushConverter}}"/>

                                <!-- Table Info -->
                                <StackPanel Grid.Column="1" Grid.Row="0" Spacing="4">
                                    <TextBlock Text="{x:Bind TableName}" 
                                               Style="{StaticResource SubtitleTextBlockStyle}" 
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind CustomerName}" 
                                               Style="{StaticResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{x:Bind CustomerName, Converter={StaticResource StringVisibilityConverter}}"/>
                                </StackPanel>

                                <!-- Session Timer -->
                                <controls:SessionTimerControl Grid.Column="2" Grid.Row="0"
                                                              SessionStartTime="{x:Bind StartTime}"
                                                              IsPaused="{x:Bind IsPaused}"
                                                              Margin="16,0"/>

                                <!-- Current Charges -->
                                <StackPanel Grid.Column="3" Grid.Row="0" 
                                            HorizontalAlignment="Right"
                                            Margin="16,0,0,0">
                                    <TextBlock Text="{x:Bind CurrentCharge, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" 
                                               Style="{StaticResource TitleTextBlockStyle}" 
                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock Text="Current Charge" 
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>

                                <!-- Session Details -->
                                <StackPanel Grid.Column="1" Grid.Row="1" 
                                            Orientation="Horizontal" 
                                            Spacing="16"
                                            Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE7C4;" FontSize="14" 
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind TableNumber}" 
                                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE77B;" FontSize="14" 
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind StatusDisplay}" 
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{x:Bind Status, Converter={StaticResource SessionStatusToBrushConverter}}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE8EF;" FontSize="14" 
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind HourlyRate, Converter={StaticResource CurrencyConverter}}" 
                                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                                        <TextBlock Text="/hr" 
                                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Server Assignment Display -->
                                <StackPanel Grid.Column="1" Grid.Row="2" 
                                            Grid.ColumnSpan="3"
                                            Orientation="Horizontal" 
                                            Spacing="8"
                                            Margin="0,8,0,0"
                                            Visibility="{x:Bind CustomerName, Converter={StaticResource StringVisibilityConverter}}">
                                    <FontIcon Glyph="&#xE77B;" FontSize="14" 
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="Server:" 
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind CustomerName}" 
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty State -->
                <StackPanel Grid.Row="1" 
                            VerticalAlignment="Center" 
                            HorizontalAlignment="Center"
                            Visibility="{x:Bind ViewModel.TotalActiveSessions, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE7C4;" FontSize="64" 
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="No active sessions" 
                               Style="{StaticResource SubtitleTextBlockStyle}" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                               Margin="0,16,0,0"/>
                    <TextBlock Text="Sessions will appear here when tables are occupied" 
                               Style="{StaticResource CaptionTextBlockStyle}" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Session Detail Panel -->
            <Grid Grid.Column="1" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Detail Panel Header -->
                <TextBlock Grid.Row="0" 
                           Text="Session Details" 
                           Style="{StaticResource SubtitleTextBlockStyle}" 
                           Margin="0,0,0,12"/>

                <!-- Detail Panel Content -->
                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16"
                                    Visibility="{x:Bind ViewModel.HasSelectedSession, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        
                        <!-- Session Information Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                CornerRadius="8" 
                                Padding="16"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Session Information" 
                                           Style="{StaticResource BodyTextBlockStyle}" 
                                           FontWeight="SemiBold"/>
                                
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" 
                                                   Text="Table:" 
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Width="80"/>
                                        <TextBlock Grid.Column="1" 
                                                   Text="{x:Bind ViewModel.SelectedSession.TableName, Mode=OneWay}" 
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   FontWeight="SemiBold"/>
                                    </Grid>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" 
                                                   Text="Status:" 
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Width="80"/>
                                        <TextBlock Grid.Column="1" 
                                                   Text="{x:Bind ViewModel.SelectedSession.StatusDisplay, Mode=OneWay}" 
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   FontWeight="SemiBold"/>
                                    </Grid>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" 
                                                   Text="Started:" 
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Width="80"/>
                                        <TextBlock Grid.Column="1" 
                                                   Text="{x:Bind ViewModel.SelectedSession.StartTime, Mode=OneWay, Converter={StaticResource DateTimeToStringConverter}}" 
                                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                                    </Grid>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" 
                                                   Text="Rate:" 
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Width="80"/>
                                        <TextBlock Grid.Column="1" 
                                                   Style="{StaticResource CaptionTextBlockStyle}">
                                            <Run Text="{x:Bind ViewModel.SelectedSession.HourlyRate, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"/>
                                            <Run Text="/hour"/>
                                        </TextBlock>
                                    </Grid>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" 
                                                   Text="Charge:" 
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Width="80"/>
                                        <TextBlock Grid.Column="1" 
                                                   Text="{x:Bind ViewModel.SelectedSession.CurrentCharge, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" 
                                                   Style="{StaticResource BodyTextBlockStyle}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Session Control Buttons -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                CornerRadius="8" 
                                Padding="16"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Session Controls" 
                                           Style="{StaticResource BodyTextBlockStyle}" 
                                           FontWeight="SemiBold"/>
                                
                                <StackPanel Spacing="8">
                                    <!-- Pause Button -->
                                    <Button Command="{x:Bind ViewModel.PauseSessionCommand}"
                                            IsEnabled="{x:Bind ViewModel.CanPauseSession, Mode=OneWay}"
                                            HorizontalAlignment="Stretch">
                                        <Button.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="P" Modifiers="Control"/>
                                        </Button.KeyboardAccelerators>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE769;" FontSize="16"/>
                                            <TextBlock Text="Pause Session"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <!-- Resume Button -->
                                    <Button Command="{x:Bind ViewModel.ResumeSessionCommand}"
                                            IsEnabled="{x:Bind ViewModel.CanResumeSession, Mode=OneWay}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            HorizontalAlignment="Stretch">
                                        <Button.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="R" Modifiers="Control"/>
                                        </Button.KeyboardAccelerators>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE768;" FontSize="16"/>
                                            <TextBlock Text="Resume Session"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <!-- End Button -->
                                    <Button Command="{x:Bind ViewModel.EndSessionCommand}"
                                            IsEnabled="{x:Bind ViewModel.CanEndSession, Mode=OneWay}"
                                            HorizontalAlignment="Stretch">
                                        <Button.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="E" Modifiers="Control"/>
                                        </Button.KeyboardAccelerators>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE71A;" FontSize="16"/>
                                            <TextBlock Text="End Session"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Additional Actions -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                CornerRadius="8" 
                                Padding="16"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Additional Actions" 
                                           Style="{StaticResource BodyTextBlockStyle}" 
                                           FontWeight="SemiBold"/>
                                
                                <StackPanel Spacing="8">
                                    <!-- Update Guest Count -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Guest Count" 
                                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <NumberBox Grid.Column="0" 
                                                       x:Name="GuestCountInput"
                                                       Minimum="1" 
                                                       Maximum="20"
                                                       SpinButtonPlacementMode="Inline"
                                                       IsEnabled="{x:Bind ViewModel.CanUpdateGuestCount, Mode=OneWay}"
                                                       Margin="0,0,8,0"/>
                                            <Button Grid.Column="1" 
                                                    Content="Update" 
                                                    Command="{x:Bind ViewModel.UpdateGuestCountCommand}"
                                                    CommandParameter="{x:Bind GuestCountInput.Value, Mode=OneWay}"
                                                    IsEnabled="{x:Bind ViewModel.CanUpdateGuestCount, Mode=OneWay}"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- No Selection State -->
                    <StackPanel VerticalAlignment="Center" 
                                HorizontalAlignment="Center"
                                Spacing="12"
                                Visibility="{x:Bind ViewModel.HasSelectedSession, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE7C4;" FontSize="48" 
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="No session selected" 
                                   Style="{StaticResource BodyTextBlockStyle}" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Select a session from the list to view details and controls" 
                                   Style="{StaticResource CaptionTextBlockStyle}" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="200"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="3" 
              Background="{ThemeResource SystemControlAcrylicWindowBrush}" 
              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="48" Height="48"/>
                <TextBlock Text="Loading sessions..." 
                           Style="{StaticResource SubtitleTextBlockStyle}" 
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Error Display -->
        <InfoBar Grid.RowSpan="3"
                 IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Severity="Error"
                 Title="Error"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 VerticalAlignment="Top"
                 Margin="24,80,24,0"/>
    </Grid>
</Page>
