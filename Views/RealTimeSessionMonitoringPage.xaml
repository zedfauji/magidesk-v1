<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Magidesk.Presentation.Views.RealTimeSessionMonitoringPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="24,16,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <TextBlock Text="Real-Time Session Monitoring" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="Monitor all active table sessions with live updates" 
                           Style="{StaticResource CaptionTextBlockStyle}" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                <Button Content="Refresh" 
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        Style="{StaticResource AccentButtonStyle}"/>
                <ToggleButton Content="Real-Time" 
                              IsChecked="{x:Bind ViewModel.IsRealTimeEnabled, Mode=TwoWay}"
                              Command="{x:Bind ViewModel.ToggleRealTimeCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Statistics Dashboard -->
        <Grid Grid.Row="1" Padding="24,8,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Active Sessions -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="8" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.TotalActiveSessions, Mode=OneWay}" 
                               Style="{StaticResource HeaderTextBlockStyle}" 
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock Text="Active Sessions" Style="{StaticResource CaptionTextBlockStyle}"/>
                </StackPanel>
            </Border>

            <!-- Paused Sessions -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="8" Padding="16" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.PausedSessions, Mode=OneWay}" 
                               Style="{StaticResource HeaderTextBlockStyle}" 
                               Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                    <TextBlock Text="Paused" Style="{StaticResource CaptionTextBlockStyle}"/>
                </StackPanel>
            </Border>

            <!-- Long Running Sessions -->
            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="8" Padding="16" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.LongRunningSessions, Mode=OneWay}" 
                               Style="{StaticResource HeaderTextBlockStyle}" 
                               Foreground="{ThemeResource SystemFillColorAttentionBrush}"/>
                    <TextBlock Text="Long Running" Style="{StaticResource CaptionTextBlockStyle}"/>
                </StackPanel>
            </Border>

            <!-- Total Revenue -->
            <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="8" Padding="16" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.TotalRevenue, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" 
                               Style="{StaticResource HeaderTextBlockStyle}" 
                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                    <TextBlock Text="Total Revenue" Style="{StaticResource CaptionTextBlockStyle}"/>
                </StackPanel>
            </Border>

            <!-- Alerts -->
            <Border Grid.Column="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="8" Padding="16" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.AlertCount, Mode=OneWay}" 
                               Style="{StaticResource HeaderTextBlockStyle}" 
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                    <TextBlock Text="Alerts" Style="{StaticResource CaptionTextBlockStyle}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="2" Padding="24,0,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sessions List -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filters and Controls -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="1" 
                              ItemsSource="{x:Bind ViewModel.AvailableFilters, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.CurrentFilter, Mode=TwoWay}"
                              DisplayMemberPath="FilterDisplay"
                              Width="150" Margin="0,0,16,0"/>

                    <TextBlock Grid.Column="2" Text="Sort:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="3" 
                              ItemsSource="{x:Bind ViewModel.AvailableSortOrders, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SortOrder, Mode=TwoWay}"
                              DisplayMemberPath="SortOrderDisplay"
                              Width="150" Margin="0,0,16,0"/>

                    <TextBlock Grid.Column="4" 
                               Text="{x:Bind ViewModel.LastRefresh, Mode=OneWay, Converter={StaticResource DateTimeToStringConverter}}" 
                               Style="{StaticResource CaptionTextBlockStyle}" 
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Sessions ListView -->
                <ListView Grid.Row="1" 
                          ItemsSource="{x:Bind ViewModel.FilteredSessions, Mode=OneWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                  CornerRadius="8" Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <!-- Status Indicator -->
                                <Border Grid.Column="0" Grid.RowSpan="2" 
                                        Width="4" CornerRadius="2" Margin="0,0,12,0"
                                        Background="{Binding Status, Converter={StaticResource SessionStatusToBrushConverter}}"/>

                                <!-- Table Info -->
                                <StackPanel Grid.Column="1" Grid.Row="0">
                                    <TextBlock Text="{Binding TableName}" Style="{StaticResource BodyTextBlockStyle}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding CustomerName}" Style="{StaticResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>

                                <!-- Session Details -->
                                <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Spacing="16">
                                    <TextBlock Text="{Binding ElapsedTimeDisplay}" Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <TextBlock Text="{Binding StatusDisplay}" Style="{StaticResource CaptionTextBlockStyle}" 
                                               Foreground="{Binding Status, Converter={StaticResource SessionStatusToBrushConverter}}"/>
                                </StackPanel>

                                <!-- Charge -->
                                <TextBlock Grid.Column="2" Grid.RowSpan="2" 
                                           Text="{Binding RunningChargeDisplay}" 
                                           Style="{StaticResource SubtitleTextBlockStyle}" 
                                           VerticalAlignment="Center" Margin="16,0"/>

                                <!-- Actions -->
                                <StackPanel Grid.Column="3" Grid.RowSpan="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Content="Control" 
                                            Command="{Binding DataContext.SelectSessionCommand, ElementName=SessionsList}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource AccentButtonStyle}" FontSize="12" Padding="8,4"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty State -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{x:Bind ViewModel.HasActiveSessions, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE7C4;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="No active sessions" Style="{StaticResource SubtitleTextBlockStyle}" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Alerts Panel -->
            <Grid Grid.Column="1" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Alerts Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="Session Alerts" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <Button Grid.Column="1" Content="Clear All" 
                            Command="{x:Bind ViewModel.ClearAlertsCommand}"
                            Visibility="{x:Bind ViewModel.HasAlerts, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>

                <!-- Alerts List -->
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.SessionAlerts, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                  CornerRadius="8" Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <!-- Alert Icon -->
                                <FontIcon Grid.Column="0" Grid.RowSpan="3" 
                                          Glyph="{Binding AlertType, Converter={StaticResource AlertTypeToGlyphConverter}}" 
                                          Foreground="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}}" 
                                          FontSize="16" VerticalAlignment="Top" Margin="0,0,8,0"/>

                                <!-- Alert Content -->
                                <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding TableName}" 
                                           Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding AlertMessage}" 
                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding CreatedAt, Converter={StaticResource DateTimeToStringConverter}}" 
                                           Style="{StaticResource CaptionTextBlockStyle}" 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- No Alerts State -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{x:Bind ViewModel.HasAlerts, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE73E;" FontSize="32" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                    <TextBlock Text="No alerts" Style="{StaticResource CaptionTextBlockStyle}" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Settings -->
                <StackPanel Grid.Row="2" Spacing="8" Margin="0,16,0,0">
                    <TextBlock Text="Settings" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Refresh:" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
                        <NumberBox Value="{x:Bind ViewModel.RefreshIntervalSeconds, Mode=TwoWay}" 
                                   Minimum="1" Maximum="60" Width="80" SpinButtonPlacementMode="Inline"/>
                        <TextBlock Text="sec" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="3" Background="{ThemeResource SystemControlAcrylicWindowBrush}" 
              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressRing IsActive="True" Width="48" Height="48"/>
                <TextBlock Text="Loading sessions..." Style="{StaticResource CaptionTextBlockStyle}" 
                           Margin="0,12,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>