<ContentDialog
    x:Class="Magidesk.Presentation.Views.Dialogs.SplitPaymentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Split Payment"
    PrimaryButtonText="Process Payment"
    CloseButtonText="Cancel"
    PrimaryButtonCommand="{Binding ProcessSplitPaymentCommand}"
    IsPrimaryButtonEnabled="{Binding CanProcessPayment}"
    x:Name="DialogRoot"
    MinWidth="600">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Instruction Text -->
        <TextBlock Grid.Row="0"
                   Text="Split the payment across multiple payment methods. The total must equal the ticket amount."
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

        <!-- Ticket Total -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0"
                       Text="Ticket Total:"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding TicketTotal.Amount, Converter={StaticResource CurrencyConverter}}"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Quick Split Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Quick Split:"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <Button Content="2-Way"
                    Command="{Binding QuickSplitCommand}"
                    CommandParameter="2"
                    Style="{StaticResource AccentButtonStyle}"
                    MinWidth="80"/>
            <Button Content="3-Way"
                    Command="{Binding QuickSplitCommand}"
                    CommandParameter="3"
                    Style="{StaticResource AccentButtonStyle}"
                    MinWidth="80"/>
            <Button Content="4-Way"
                    Command="{Binding QuickSplitCommand}"
                    CommandParameter="4"
                    Style="{StaticResource AccentButtonStyle}"
                    MinWidth="80"/>
        </StackPanel>

        <!-- Payment Entries List -->
        <ScrollViewer Grid.Row="3" MaxHeight="300">
            <ItemsControl ItemsSource="{Binding Payments}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12"
                                Margin="0,0,0,8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Payment Method -->
                                <ComboBox Grid.Column="0"
                                          Header="Payment Method"
                                          ItemsSource="{Binding DataContext.AvailablePaymentMethods, ElementName=DialogRoot}"
                                          SelectedItem="{Binding Method, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"/>

                                <!-- Amount -->
                                <TextBox Grid.Column="1"
                                         Header="Amount"
                                         Text="{Binding Amount.Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         InputScope="Number"
                                         HorizontalAlignment="Stretch"/>

                                <!-- Remove Button -->
                                <Button Grid.Column="2"
                                        Content="&#xE74D;"
                                        FontFamily="Segoe MDL2 Assets"
                                        Command="{Binding DataContext.RemovePaymentCommand, ElementName=DialogRoot}"
                                        CommandParameter="{Binding}"
                                        VerticalAlignment="Bottom"
                                        ToolTipService.ToolTip="Remove Payment"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Add Payment Button -->
        <Button Grid.Row="4"
                Command="{Binding AddPaymentCommand}"
                HorizontalAlignment="Left"
                Style="{StaticResource AccentButtonStyle}">
            <Button.Content>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="16"/>
                    <TextBlock Text="Add Payment"/>
                </StackPanel>
            </Button.Content>
        </Button>

        <!-- Totals Summary -->
        <Grid Grid.Row="5" ColumnSpacing="16" Padding="12" 
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              CornerRadius="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Entered -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Total Entered"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="12"/>
                <TextBlock Text="{Binding TotalEntered.Amount, Converter={StaticResource CurrencyConverter}}"
                           FontSize="18"
                           FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Remaining -->
            <StackPanel Grid.Column="1">
                <TextBlock Text="Remaining"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="12"/>
                <TextBlock Text="{Binding RemainingAmount.Amount, Converter={StaticResource CurrencyConverter}}"
                           FontSize="18"
                           FontWeight="SemiBold">
                    <TextBlock.Foreground>
                        <SolidColorBrush Color="{ThemeResource SystemAccentColor}"/>
                    </TextBlock.Foreground>
                </TextBlock>
            </StackPanel>

            <!-- Change (if overpayment) -->
            <StackPanel Grid.Column="2"
                        Visibility="{Binding ChangeAmount, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Change"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="12"/>
                <TextBlock Text="{Binding ChangeAmount.Amount, Converter={StaticResource CurrencyConverter}}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Error Message -->
        <InfoBar Grid.Row="6"
                 IsOpen="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                 Severity="Error"
                 Message="{Binding ErrorMessage}"/>

    </Grid>
</ContentDialog>
