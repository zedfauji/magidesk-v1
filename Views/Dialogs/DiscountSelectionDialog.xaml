<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Magidesk.Presentation.Views.Dialogs.DiscountSelectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Apply Discount"
    PrimaryButtonText="Apply Discount"
    CloseButtonText="Cancel"
    IsPrimaryButtonEnabled="{Binding CanApplyDiscount}"
    PrimaryButtonClick="OnPrimaryButtonClick"
    x:Name="DialogRoot"
    MinWidth="600"
    Loaded="OnLoaded">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Select a discount to apply to this ticket. Discounts over 50% require manager authorization."
                   TextWrapping="Wrap"/>

        <ScrollViewer Grid.Row="1" MaxHeight="400">
            <ListView ItemsSource="{Binding AvailableDiscounts}"
                      SelectedItem="{Binding SelectedDiscount, Mode=TwoWay}"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Run Text="{Binding Value}"/>
                                <Run Text="{Binding Type}"/>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>

        <InfoBar Grid.Row="2" 
                 x:Name="ErrorInfoBar"
                 Severity="Error"
                 Message="{Binding ErrorMessage}"
                 IsOpen="False"/>

    </Grid>
</ContentDialog>
