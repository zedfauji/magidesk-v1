<ContentDialog
    x:Class="Magidesk.Presentation.Views.Dialogs.HoldTicketDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Hold Ticket"
    PrimaryButtonText="Hold Ticket"
    CloseButtonText="Cancel"
    PrimaryButtonCommand="{Binding HoldTicketCommand}"
    IsPrimaryButtonEnabled="{Binding CanSubmit}"
    x:Name="DialogRoot">

    <Grid RowSpacing="16" Width="450">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Instruction Text -->
        <TextBlock Grid.Row="0"
                   Text="Please provide a reason for holding this ticket. The table will be released for other customers."
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

        <!-- Reason Code Dropdown -->
        <ComboBox Grid.Row="1"
                  Header="Reason"
                  ItemsSource="{Binding ReasonCodes}"
                  SelectedItem="{Binding SelectedReasonCode, Mode=TwoWay}"
                  PlaceholderText="Select a reason..."
                  HorizontalAlignment="Stretch"/>

        <!-- Custom Reason Input -->
        <TextBox Grid.Row="2"
                 Text="{Binding HoldReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="80"
                 PlaceholderText="Enter custom reason (if Other selected)..."
                 Header="Custom Reason"/>

        <!-- Error Message -->
        <InfoBar Grid.Row="3"
                 IsOpen="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                 Severity="Error"
                 Message="{Binding ErrorMessage}"/>

    </Grid>
</ContentDialog>
