<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Magidesk.Presentation.Views.Dialogs.SessionControlDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Session Control"
    SecondaryButtonText="Cancel"
    DefaultButton="Primary"
    SecondaryButtonCommand="{x:Bind ViewModel.CancelCommand}">

    <ScrollViewer MaxHeight="500" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Margin="24">
            
            <!-- Header Information -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Session Control" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.TableName, Mode=OneWay}" 
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    
                    <!-- Current Session Info -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Status:" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,8,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.SessionStatus, Mode=OneWay}" 
                                   Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"/>
                        
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Elapsed:" Style="{StaticResource CaptionTextBlockStyle}" Margin="16,0,8,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{x:Bind ViewModel.ElapsedTime, Mode=OneWay, Converter={StaticResource TimeSpanToStringConverter}}" 
                                   Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Guests:" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,4,8,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.CurrentGuestCount, Mode=OneWay}" 
                                   Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Charge:" Style="{StaticResource CaptionTextBlockStyle}" Margin="16,4,8,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{x:Bind ViewModel.CurrentCharge, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" 
                                   Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"/>
                    </Grid>

                    <!-- Paused Duration (if applicable) -->
                    <StackPanel Orientation="Horizontal" Spacing="8" 
                                Visibility="{x:Bind ViewModel.PausedDuration, Mode=OneWay, Converter={StaticResource TimeSpanToVisibilityConverter}}">
                        <TextBlock Text="Paused Duration:" Style="{StaticResource CaptionTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.PausedDuration, Mode=OneWay, Converter={StaticResource TimeSpanToStringConverter}}" 
                                   Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" 
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Error Display -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Severity="Error"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     Margin="0,0,0,8"/>

            <!-- Action Buttons -->
            <StackPanel Spacing="12">
                
                <!-- Pause/Resume Section -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Session Control" Style="{StaticResource BaseTextBlockStyle}" FontWeight="SemiBold"/>
                    
                    <!-- Pause Section -->
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsPaused, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <ComboBox Header="Reason for pause:"
                                  ItemsSource="{x:Bind ViewModel.PauseReasons, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.PauseReason, Mode=TwoWay}"
                                  PlaceholderText="Select a reason..."
                                  HorizontalAlignment="Stretch"/>
                        
                        <Button Content="Pause Session" 
                                Command="{x:Bind ViewModel.PauseSessionCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- Resume Section -->
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsPaused, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Session is currently paused" 
                                   Style="{StaticResource CaptionTextBlockStyle}" 
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                        
                        <Button Content="Resume Session" 
                                Command="{x:Bind ViewModel.ResumeSessionCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>

                <!-- Guest Count Update Section -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Guest Count" Style="{StaticResource BaseTextBlockStyle}" FontWeight="SemiBold"/>
                    
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <NumberBox Header="New guest count:"
                                   Value="{x:Bind ViewModel.NewGuestCount, Mode=TwoWay}"
                                   Minimum="1" Maximum="20"
                                   SpinButtonPlacementMode="Inline"
                                   Width="120"/>
                        
                        <Button Content="Update Count" 
                                Command="{x:Bind ViewModel.UpdateGuestCountCommand}"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,4"/>
                    </StackPanel>
                    
                    <TextBlock Text="Current guest count will affect pricing calculations" 
                               Style="{StaticResource CaptionTextBlockStyle}" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

            </StackPanel>

            <!-- Information Section -->
            <Border Background="{ThemeResource SystemFillColorSolidNeutralBackgroundBrush}" 
                    CornerRadius="8" Padding="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="Session Control Information" 
                               Style="{StaticResource CaptionTextBlockStyle}" 
                               FontWeight="SemiBold"/>
                    <TextBlock Text="• Pausing a session stops billing until resumed" 
                               Style="{StaticResource CaptionTextBlockStyle}"/>
                    <TextBlock Text="• Guest count changes may affect final pricing" 
                               Style="{StaticResource CaptionTextBlockStyle}"/>
                    <TextBlock Text="• All actions are logged for audit purposes" 
                               Style="{StaticResource CaptionTextBlockStyle}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>