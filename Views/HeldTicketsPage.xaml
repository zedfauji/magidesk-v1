<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Magidesk.Presentation.Views.HeldTicketsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="PageRoot"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <d:CurrencyConverter x:Key="CurrencyConverter" xmlns:d="using:Magidesk.Presentation.Converters"/>
        <d:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" xmlns:d="using:Magidesk.Presentation.Converters"/>
        <d:StringToBoolConverter x:Key="StringToBoolConverter" xmlns:d="using:Magidesk.Presentation.Converters"/>
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE769;" FontSize="32" Foreground="Orange"/> <!-- Pause icon -->
                <TextBlock Text="{x:Bind ViewModel.Title}" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
            </StackPanel>
            
            <Button Command="{x:Bind ViewModel.RefreshCommand}" 
                    HorizontalAlignment="Right" 
                    Background="{ThemeResource SystemAccentColor}" 
                    Foreground="White">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="16"/> <!-- Refresh icon -->
                    <TextBlock Text="Refresh"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Status Messages -->
        <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,16">
            <InfoBar Title="Error" 
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" 
                     IsOpen="{x:Bind ViewModel.ErrorMessage, Converter={StaticResource StringToBoolConverter}, Mode=OneWay}" 
                     Severity="Error" />
 
            <InfoBar Title="Status" 
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                     IsOpen="{x:Bind ViewModel.StatusMessage, Converter={StaticResource StringToBoolConverter}, Mode=OneWay}" 
                     Severity="Success" />
        </StackPanel>

        <!-- Held Tickets DataGrid -->
        <Border Grid.Row="2" 
                Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" 
                CornerRadius="8" 
                Padding="16">
            <Grid>
                <!-- Loading Indicator -->
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" 
                              Width="60" 
                              Height="60" 
                              HorizontalAlignment="Center" 
                              VerticalAlignment="Center"
                              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- DataGrid -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Auto"
                              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                    <Grid>
                        <TextBlock Text="No held tickets found" 
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,40,0,0"
                                   Visibility="{x:Bind ViewModel.HeldTickets.Count, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>

                        <ListView ItemsSource="{x:Bind ViewModel.HeldTickets, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedTicket, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  Visibility="{x:Bind ViewModel.HeldTickets.Count, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="dto:HeldTicketDto" xmlns:dto="using:Magidesk.Application.DTOs">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16"
                                            Margin="0,4">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                                <ColumnDefinition Width="120"/> <!-- Ticket # -->
                                                <ColumnDefinition Width="*"/> <!-- Customer -->
                                                <ColumnDefinition Width="100"/> <!-- Table -->
                                                <ColumnDefinition Width="120"/> <!-- Amount -->
                                                <ColumnDefinition Width="180"/> <!-- Held At -->
                                                <ColumnDefinition Width="*"/> <!-- Reason -->
                                                <ColumnDefinition Width="150"/> <!-- Held By -->
                                                <ColumnDefinition Width="Auto"/> <!-- Actions -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Icon -->
                                            <FontIcon Grid.Column="0" 
                                                      Glyph="&#xE769;" 
                                                      FontSize="24" 
                                                      Foreground="Orange"
                                                      VerticalAlignment="Center"/>

                                            <!-- Ticket Number -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Ticket #" 
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                                <TextBlock Text="{x:Bind TicketNumber}" 
                                                           FontWeight="SemiBold"
                                                           FontSize="16"/>
                                            </StackPanel>

                                            <!-- Customer -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="Customer" 
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                                <TextBlock Text="{x:Bind CustomerName}" 
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Table -->
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                <TextBlock Text="Table" 
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                                <TextBlock Text="{x:Bind TableNumber}" 
                                                           FontWeight="SemiBold"/>
                                            </StackPanel>

                                            <!-- Amount -->
                                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                <TextBlock Text="Amount" 
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                                <TextBlock Text="{x:Bind TotalAmount, Converter={StaticResource CurrencyConverter}}" 
                                                           FontWeight="SemiBold"
                                                           FontSize="16"
                                                           Foreground="{ThemeResource SystemAccentColor}"/>
                                            </StackPanel>

                                            <!-- Held At -->
                                            <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                                <TextBlock Text="Held At" 
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                                <TextBlock Text="{x:Bind HeldAt}" 
                                                           FontSize="12"/>
                                            </StackPanel>

                                            <!-- Reason -->
                                            <StackPanel Grid.Column="6" VerticalAlignment="Center">
                                                <TextBlock Text="Reason" 
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                                <TextBlock Text="{x:Bind HoldReason}" 
                                                           TextWrapping="Wrap"
                                                           MaxLines="2"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Held By -->
                                            <StackPanel Grid.Column="7" VerticalAlignment="Center">
                                                <TextBlock Text="Held By" 
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                                <TextBlock Text="{x:Bind HeldByUserName}"/>
                                            </StackPanel>

                                            <!-- Actions -->
                                            <StackPanel Grid.Column="8" 
                                                        Orientation="Horizontal" 
                                                        Spacing="8" 
                                                        VerticalAlignment="Center">
                                                <Button Command="{Binding ElementName=PageRoot, Path=ViewModel.ViewTicketDetailsCommand}"
                                                        CommandParameter="{x:Bind}"
                                                        Background="RoyalBlue"
                                                        Foreground="White"
                                                        Height="36"
                                                        Padding="12,0">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE8A7;" FontSize="14"/> <!-- View icon -->
                                                        <TextBlock Text="View"/>
                                                    </StackPanel>
                                                </Button>
                                                
                                                <Button Command="{Binding ElementName=PageRoot, Path=ViewModel.ReleaseTicketCommand}"
                                                        CommandParameter="{x:Bind}"
                                                        Background="Green"
                                                        Foreground="White"
                                                        Height="36"
                                                        Padding="12,0">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE768;" FontSize="14"/> <!-- Play icon -->
                                                        <TextBlock Text="Release"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
